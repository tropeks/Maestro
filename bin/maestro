# --------------------------------------------------------------- conduct (E17)

cmd_conduct() { # S-1702: regência — mutação genérica do decision record
  # decide grava a APOSTA (workflow/mode/agents/depth/profile/brief); conduct
  # MUTA o record já existente, mesmo precedente de escrita de `outcome`:
  # (i) acumula flags[] tipadas (sev|decisao|tradeoff|mitigacao) consolidadas
  # pelo diretor a partir dos veredicts dos agentes; (ii) fecha o `approach:`
  # pendente do brief quando o plano nasce. Verbo genérico: cobre os dois
  # pontos de enforcement do item 4 do design com um único subcomando.
  local sid="" approach="" flags=()
  while (( $# )); do
    case "$1" in
      --session)  sid="${2:-}"; shift ;;
      --flag)     flags+=("${2:-}"); shift ;;
      --approach) approach="${2:-}"; shift ;;
      *) die validation "argumento desconhecido '$1'" \
           "maestro conduct --session <id> [--flag \"sev|decisao|tradeoff|mitigacao\"]... [--approach texto]" 1 ;;
    esac
    shift
  done
  [[ "$sid" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || die validation "session_id obrigatório" \
    "maestro conduct --session <id> [--flag ...] [--approach ...]" 1
  if [[ ${#flags[@]} -eq 0 && -z "$approach" ]]; then
    die validation "nada a registrar" "informe pelo menos um --flag ou --approach" 1
  fi
  [[ -z "$approach" || "${#approach}" -le 200 ]] || die validation "--approach excede 200 chars" "" 1
  has jq || die env "conduct exige jq" "instale jq (dependência declarada)" 2

  # shellcheck source=hooks/lib/common.sh
  source "$REPO_DIR/hooks/lib/common.sh"
  local rec="$MAESTRO_SESSIONS_DIR/$sid.json"
  [[ -f "$rec" ]] || die validation "não há decision record para a sessão $sid" \
    "conduct muta uma decisão existente (maestro decide primeiro)" 1

  # --flag "sev|decisao|tradeoff|mitigacao": exatamente 4 campos (3 '|'),
  # sev no enum fechado, cada campo <=120 chars, sem tab.
  local flag_objs=() f sev decisao tradeoff mitigacao pipes part
  for f in "${flags[@]}"; do
    [[ "$f" != *$'\t'* ]] || die validation "--flag não pode conter tab" "$f" 1
    pipes="${f//[^|]/}"
    [[ ${#pipes} -eq 3 ]] || die validation \
      "--flag exige exatamente 4 campos 'sev|decisao|tradeoff|mitigacao'" "$f" 1
    IFS='|' read -r sev decisao tradeoff mitigacao <<<"$f"
    [[ "$sev" =~ ^(critical|high|medium|low)$ ]] || die validation "sev fora do enum" \
      "critical|high|medium|low (recebido '$sev')" 1
    for part in "$sev" "$decisao" "$tradeoff" "$mitigacao"; do
      [[ "${#part}" -le 120 ]] || die validation "--flag com campo acima de 120 chars" "$f" 1
    done
    flag_objs+=("$(jq -nc --arg s "$sev" --arg d "$decisao" --arg t "$tradeoff" --arg m "$mitigacao" \
      '{sev:$s, decisao:$d, tradeoff:$t, mitigacao:$m}')")
  done
  local n_flags=${#flag_objs[@]}
  local new_flags_json='[]'
  if [[ $n_flags -gt 0 ]]; then
    new_flags_json=$(printf '%s\n' "${flag_objs[@]}" | jq -sc '.')
  fi

  local approach_flag="no"
  if [[ -n "$approach" ]]; then
    jq -e 'has("brief")' "$rec" >/dev/null 2>&1 || die validation "record sem brief" \
      "approach exige brief no record (maestro decide --brief \"essencia: ... impacto: ... approach: pendente\")" 1
    approach_flag="yes"
  fi

  local tmp="$rec.tmp.$$"
  if jq --argjson new_flags "$new_flags_json" --arg appr "$approach" --arg has_appr "$approach_flag" '
       (if ($new_flags | length) > 0 then .flags = ((.flags // []) + $new_flags) else . end)
       | (if $has_appr == "yes"
          then .brief = (.brief | sub("approach:.*$"; "approach: " + $appr))
          else . end)
     ' "$rec" > "$tmp" 2>/dev/null && chmod 600 "$tmp" 2>/dev/null && mv -f "$tmp" "$rec" 2>/dev/null; then
    log_event conduct session_id="$sid" flags_n="$n_flags" approach="$approach_flag"
    local appr_note=""
    if [[ "$approach_flag" == "yes" ]]; then appr_note=" · approach atualizado"; fi
    printf 'record %s mutado: %s flag(s)%s\n' "$sid" "$n_flags" "$appr_note"
  else
    rm -f "$tmp" 2>/dev/null
    die env "falha ao atualizar o record" "cheque permissões em $MAESTRO_SESSIONS_DIR" 2
  fi
  return 0
}

