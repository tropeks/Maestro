# --------------------------------------------------------------- upgrade (E19)

_upgrade_failed_msg() { # <motivo> → mensagem humana para UPD_STATE=failed
  case "$1" in
    not-a-repo) printf '%s' "o plugin não roda de um clone git — reinstale com git clone (ADR-001)" ;;
    no-remote)  printf '%s' "clone sem remoto 'origin'" ;;
    no-remote-ref) printf 'fetch falhou e não há ref conhecido do canal %s neste clone (rede? URL?)' "$UPD_CHANNEL" ;;
    *) printf 'checagem falhou (%s)' "$1" ;;
  esac
}

_upgrade_blocked_msg() { # usa UPD_REASON/UPD_AHEAD/UPD_BRANCH_CUR do estado corrente
  case "$UPD_REASON" in
    ahead)
      if [[ "$UPD_CHANNEL" == "stable" ]]; then
        printf 'esta árvore tem %s commit(s) à frente da tag stable (ainda não aprovados pela CI) — nada a puxar' "$UPD_AHEAD"
      else
        printf 'esta árvore tem %s commit(s) à frente do origin — máquina de desenvolvimento: git push, não pull' "$UPD_AHEAD"
      fi ;;
    dirty) printf '%s' "árvore suja — commite ou guarde (git stash) antes" ;;
    branch) printf "branch '%s' não é main — git checkout main" "$UPD_BRANCH_CUR" ;;
    in-progress) printf '%s' "merge/rebase em andamento — termine ou aborte antes" ;;
    *) printf 'merge bloqueado (%s)' "$UPD_REASON" ;;
  esac
}

_upgrade_no_stable_msg() { # E23c: canal stable sem a tag no remoto — não é erro
  printf '%s' "canal stable: o origin ainda não tem a tag 'stable' — nada a aplicar (a CI a move quando shellcheck + suíte passam numa tag v*; maestro upgrade --channel main segue o topo da main)"
}

_upgrade_rollback_failed_msg() { # <motivo> → mensagem humana para maestro_update_rollback
  case "$1" in
    no-prev) printf '%s' "nada para desfazer — nenhum upgrade registrado" ;;
    prev-missing) printf '%s' "commit anterior não existe mais neste clone" ;;
    reset) printf '%s' "git reset --keep recusou: alteração local seria perdida" ;;
    diverged) printf '%s' "há commit local depois do upgrade — o rollback é manual (git log / git reflog), a ferramenta não desfaz trabalho seu" ;;
    *) printf 'rollback falhou (%s)' "$1" ;;
  esac
}

_upgrade_apply() { # aplica e reporta a versão nova (chamado só quando UPD_STATE=available)
  local behind="$UPD_BEHIND"
  if ! maestro_update_apply; then
    die validation "aplicar a atualização falhou ($UPD_REASON)" \
      "árvore/remoto podem ter mudado — rode maestro upgrade --check --force" 1
  fi
  log_event upgrade from="$UPD_FROM" to="$UPD_LOCAL" via=manual channel="$UPD_CHANNEL"
  printf 'Maestro v%s → v%s (%s commit(s), canal %s)\n' "$UPD_FROM" "$UPD_LOCAL" "$behind" "$UPD_CHANNEL"

  local delta
  # Cabeçalho por PREFIXO: o CHANGELOG real é `## [1.14.0] — 2026-09-05`, e a
  # igualdade exata deixava todo upgrade dizer "sem entradas" (visto na forge).
  delta=$(awk -v to="## [$UPD_LOCAL]" -v from="## [$UPD_FROM]" '
      index($0, to) == 1   { inrange = 1; print; next }
      inrange && index($0, from) == 1 { exit }
      inrange              { print }
    ' "$UPD_REPO/CHANGELOG.md" 2>/dev/null) || delta=""
  if [[ -n "$delta" ]]; then
    printf '%s\n' "$delta"
  else
    printf 'changelog: sem entradas entre as versões\n'
  fi
  printf 'rollback: maestro upgrade --rollback (volta para %s)\n' "${UPD_PREV:0:7}"

  # o binário NOVO valida a instalação nova — só quando $UPD_REPO é o MESMO
  # clone que este CLI está rodando (nada de exec num repo de teste alheio).
  if [[ -x "$UPD_REPO/bin/maestro" ]]; then
    local upd_real repo_real
    upd_real=$(cd -P -- "$UPD_REPO" && pwd) || upd_real=""
    repo_real=$(cd -P -- "$REPO_DIR" && pwd) || repo_real=""
    if [[ -n "$upd_real" && "$upd_real" == "$repo_real" ]]; then
      exec "$UPD_REPO/bin/maestro" doctor --ci
    fi
  fi
  printf 'doctor: rode maestro doctor no plugin atualizado\n'
  return 0
}

_upgrade_run() { # sem flag: verifica com --force e age pelo estado
  maestro_update_check --force
  case "$UPD_STATE" in
    failed)
      die env "$(_upgrade_failed_msg "$UPD_REASON")" "veja a mensagem acima" 2 ;;
    current)
      local origem="origin/main"
      [[ "$UPD_CHANNEL" == "stable" ]] && origem="tag stable"
      local msg="Maestro v$UPD_LOCAL já é a última versão ($origem)"
      [[ "$UPD_FETCH" == "failed" ]] && \
        msg+=" — fetch falhou; comparado com o último $origem conhecido"
      printf '%s\n' "$msg"; return 0 ;;
    no-stable)
      printf '%s\n' "$(_upgrade_no_stable_msg)"; return 0 ;;
    blocked)
      printf '%s\n' "$(_upgrade_blocked_msg)"; exit 1 ;;
    available)
      _upgrade_apply; return 0 ;;
    *)
      die env "estado de atualização desconhecido ($UPD_STATE)" "maestro doctor" 2 ;;
  esac
}

_upgrade_check() { # --check [--force]: nunca aplica, mesmo com auto_upgrade
  local force="$1"
  if [[ "$force" == "1" ]]; then maestro_update_check --force; else maestro_update_check; fi
  local line="" rc=0
  case "$UPD_STATE" in
    disabled) line="atualização: verificação desligada"; rc=0 ;;
    no-stable)
      line="atualização: $(_upgrade_no_stable_msg)"; rc=0 ;;
    current)
      # Sem fetch nesta chamada a afirmação é sobre o ÚLTIMO origin visto, não sobre
      # o origin de agora — e o humano precisa saber (gstack #1974).
      line="atualização: em dia (v$UPD_LOCAL, canal $UPD_CHANNEL)"
      [[ "$UPD_FETCH" == "skipped" ]] && line+=" — cache do último fetch; --force consulta o origin"
      [[ "$UPD_FETCH" == "failed" ]] && line+=" — fetch FALHOU; comparado com o último origin conhecido"
      rc=0 ;;
    available)
      line="atualização: v$UPD_LOCAL → v$UPD_REMOTE_VER disponível ($UPD_BEHIND commit(s), canal $UPD_CHANNEL) — maestro upgrade"
      rc=1 ;;
    blocked)
      line="atualização: v$UPD_REMOTE_VER no origin, merge bloqueado ($UPD_REASON)"; rc=1 ;;
    failed)
      line="atualização: falhou ($UPD_REASON)"; rc=2 ;;
    *) line="atualização: estado desconhecido ($UPD_STATE)"; rc=2 ;;
  esac
  printf '%s\n' "$line"
  exit "$rc"
}

_upgrade_rollback() { # --rollback: git reset --keep para o prev registrado, sem rede
  if maestro_update_rollback; then
    log_event upgrade from="$UPD_FROM" to="$UPD_LOCAL" via=rollback channel="$UPD_CHANNEL"
    printf 'Maestro v%s → v%s (rollback); maestro upgrade reaplica\n' "$UPD_FROM" "$UPD_LOCAL"
    return 0
  fi
  die validation "$(_upgrade_rollback_failed_msg "$UPD_REASON")" "veja a mensagem acima" 1
}

_upgrade_snooze() { # --snooze: adia só o AVISO da versão remota atual (24h→48h→7d)
  maestro_update_check
  case "$UPD_STATE" in
    available)
      if maestro_update_snooze; then
        printf 'aviso adiado por %s (v%s)\n' "$UPD_SNOOZE_HUMAN" "$UPD_REMOTE_VER"
      else
        die validation "não consegui adiar ($UPD_REASON)" "tente de novo" 1
      fi ;;
    current)  printf 'nada a adiar: já na última versão\n' ;;
    no-stable) printf 'nada a adiar: %s\n' "$(_upgrade_no_stable_msg)" ;;
    blocked)  printf '%s\n' "$(_upgrade_blocked_msg)" ;;
    failed)   printf 'atualização: falhou (%s)\n' "$UPD_REASON"; exit 2 ;;
    *)        printf 'atualização: estado desconhecido (%s)\n' "$UPD_STATE" ;;
  esac
  return 0
}

_upgrade_set() { # --set chave=valor: só as 3 chaves de config.yaml que a lib entende
  local kv="$1"
  [[ "$kv" == *=* ]] || die validation "formato inválido (esperado chave=valor)" \
    "maestro upgrade --set chave=valor" 1
  local key="${kv%%=*}" val="${kv#*=}"
  case "$key" in
    update_check|auto_upgrade)
      [[ "$val" == "true" || "$val" == "false" ]] || die validation \
        "valor inválido para '$key': '$val' (esperado true|false)" \
        "maestro upgrade --set $key=true|false" 1 ;;
    update_interval_hours)
      [[ "$val" =~ ^[0-9]{1,3}$ ]] && (( 10#$val >= 1 && 10#$val <= 720 )) || die validation \
        "valor inválido para 'update_interval_hours': '$val' (esperado inteiro 1..720)" \
        "maestro upgrade --set update_interval_hours=24" 1 ;;
    update_channel)
      [[ "$val" == "stable" || "$val" == "main" ]] || die validation \
        "valor inválido para 'update_channel': '$val' (esperado stable|main)" \
        "maestro upgrade --set update_channel=stable" 1 ;;
    *) die validation "chave desconhecida '$key'" \
        "chaves válidas: update_check, auto_upgrade, update_interval_hours, update_channel" 1 ;;
  esac
  maestro_update_config_set "$key" "$val" || \
    die env "falha ao gravar config.yaml" "verifique permissões em \$MAESTRO_HOME" 2
  printf 'config.yaml: %s = %s\n' "$key" "$val"
}

cmd_upgrade() { # E19/S-1902 — CLI do auto-update: source direto da lib do S-1901
  # UPD_MANUAL=1 é a diferença entre o hook (silencioso, respeita config) e o
  # CLI (ação explícita do humano — ignora update_check:false e o kill-switch
  # de checagem, nunca a rede em si).
  local mode="" force=0 setkv="" channel=""
  while (( $# )); do
    case "$1" in
      --check)   mode="check" ;;
      --force)   force=1 ;;
      --channel) # override PONTUAL do canal (E23c): não escreve config.yaml
                 if (( $# > 1 )); then channel="$2"; shift; else channel=""; fi
                 [[ "$channel" == "stable" || "$channel" == "main" ]] || die validation \
                   "canal inválido '${channel:-}' (esperado stable|main)" \
                   "maestro upgrade --channel stable|main" 1 ;;
      --rollback) mode="rollback" ;;
      --snooze)  mode="snooze" ;;
      --set)     mode="set"
                 # `--set` como último argumento: sem o `(( $# > 1 ))` o shift
                 # interno esvaziaria $@ e o shift do laço morreria sob set -e
                 # com erro cru do bash em vez do die de validação.
                 if (( $# > 1 )); then setkv="$2"; shift; else setkv=""; fi ;;
      *) die validation "flag desconhecida '$1'" \
           "maestro upgrade [--check [--force]|--rollback|--snooze|--set chave=valor|--channel stable|main]" 1 ;;
    esac
    shift
  done
  if (( force == 1 )) && [[ "$mode" != "check" ]]; then
    die validation "flag desconhecida '--force'" \
      "maestro upgrade [--check [--force]|--rollback|--snooze|--set chave=valor|--channel stable|main]" 1
  fi
  [[ -z "$mode" ]] && mode="run"

  # shellcheck source=hooks/lib/common.sh
  source "$REPO_DIR/hooks/lib/common.sh"
  export UPD_MANUAL=1
  # o override do canal entra pelo env que a lib já respeita (env vence config),
  # e vale só neste processo — nada é gravado no config.yaml.
  [[ -n "$channel" ]] && export MAESTRO_UPDATE_CHANNEL="$channel"
  # shellcheck source=hooks/lib/update-check.sh
  source "$REPO_DIR/hooks/lib/update-check.sh"

  case "$mode" in
    run)      _upgrade_run ;;
    check)    _upgrade_check "$force" ;;
    rollback) _upgrade_rollback ;;
    snooze)   _upgrade_snooze ;;
    set)      _upgrade_set "$setkv" ;;
  esac
  return 0
}

