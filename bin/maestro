#!/usr/bin/env bash
# maestro — CLI do plugin (E1: doctor; E2: decide/status/log delegados ao src/cli.ts em Bun)
#
# Contratos normativos:
#   docs/architecture/API_SPEC.md   §2 (maestro doctor) e §3 (envelope de erro / exit codes)
#   docs/architecture/DATA_MODEL.md §1 (routing-table.yaml) e §3 (decision record)
#   docs/architecture/EPICS.md      S-103 (AC: detecta hook não registrado e YAML inválido)
#
# Regras respeitadas aqui:
#   - o doctor PRECISA funcionar sem Bun (é ele que diagnostica ambiente quebrado):
#     validação de YAML/JSON usa Bun quando existe e cai para checagem estrutural em bash quando não
#   - sem rede; sem dependência que não seja coreutils (jq/flock/bun são *diagnosticados*, não exigidos)
#   - "dependência ausente" nunca é reportado como "arquivo inválido" (review P2-7)
#
# Exit codes (API_SPEC §3): 0 ok · 1 falha de validação (conteúdo inválido) · 2 ambiente quebrado
# (arquivo/dependência/permissão faltando). Havendo falhas das duas classes, prevalece 2.
set -euo pipefail

# ---------------------------------------------------------------- resolução de caminho
# review P1-4: `ln -s .../bin/maestro ~/bin/maestro` é um dos dois métodos de instalação do
# ADR-001; `dirname "${BASH_SOURCE[0]}"` sozinho resolve para o diretório do link e o CLI
# perde o repo. Resolve a cadeia de symlinks com readlink -f e cai para um loop portátil.
maestro_realpath() {
  local src="$1" dir out
  if out=$(readlink -f -- "$src" 2>/dev/null) && [[ -n "$out" ]]; then
    printf '%s\n' "$out"; return 0
  fi
  local guard=0
  while [[ -L "$src" ]]; do
    guard=$((guard + 1)); [[ $guard -gt 40 ]] && break
    dir=$(cd -P -- "$(dirname -- "$src")" && pwd)
    src=$(readlink -- "$src")
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  dir=$(cd -P -- "$(dirname -- "$src")" && pwd)
  printf '%s\n' "$dir/$(basename -- "$src")"
}

SELF="$(maestro_realpath "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd -P -- "$(dirname -- "$SELF")/.." && pwd)"
# Mesma costura de teste do session-start: o default é o roster instalado.
AGENTS_DIR="${MAESTRO_AGENTS_DIR:-$REPO_DIR/agents}"
MAESTRO_HOME="${MAESTRO_HOME:-$HOME/.maestro}"
MAESTRO_HOME_DEFAULT="$HOME/.maestro"
MAESTRO_TTL_SECONDS="${MAESTRO_TTL_SECONDS:-14400}"

EXPECTED_EVENTS=(SessionStart PreToolUse PostToolUse UserPromptSubmit)
EXPECTED_MATCHER_TOOLS=(Edit Write MultiEdit)
RECORD_FIELDS='session_id ts expires_at workflow mode agents reason wtree outcome outcome_ts suite suite_evidence budget depth profile brief flags'

usage() {
  cat <<'U'
maestro <comando>
  doctor [--ci]   valida a instalação (hooks registrados, dependências, schemas, permissões,
                  decision records) e remove records expirados
                  --ci: saída enxuta, sem cor, só avisos/falhas + resumo (ENGINEERING_SPEC §CI/CD)
  decide          registra decisão de roteamento (delegado a src/cli.ts — requer Bun)
  status          mostra decisão da sessão corrente (idem)
  log             agrega o routing.jsonl (idem)
  habits          habit sensors (E9) sobre o diff (default), --all ou caminhos: os mesmos
                  sensores anti-slop do hook pós-edição, com os guias — 0 limpo · 1 achados
                  --baseline grava a catraca (.maestro-habits.tsv, versionada); com ela
                  presente, --all reprova SÓ o que exceder o baseline (S-905)
  docs            docs canônicos como contrato (E16): frescor por covers/reviewed,
                  drift em commits com quitação por fronteira; --baseline/--check = catraca
  order           work order versionada (E15): --create/--list/--status/--accept — estado
                  DERIVADO de git + evidência + aceite; executor não fecha a própria ordem
  evidence        recibo de execução amarrado a conteúdo (E13): --record -- <cmd> grava
                  wtree antes/depois + hash do comando + exit; leitura dá VÁLIDA/VENCIDA
                  nomeando o motivo — "testes passaram" vira checagem mecânica
  graph           freshness do grafo graphify (E11): mtime do graphify-out/graph.json vs
                  último commit — --check sai 1 se STALE (para a rotina de refresh)
  consent         consentimento escopado (E10): --grant/--revoke routing-table|roster|ops,
                  TTL 1min–4h — dados na denylist ou infra no guarda; nunca hooks/bin/src,
                  nunca destruição de dados (ops não cobre rm -rf/force push/DROP)
  outcome         desfecho da decisão (E10): accepted|rework|reverted [--suite pass|fail]
  conduct         regência (E17): muta o decision record existente — --flag
                  "sev|decisao|tradeoff|mitigacao" (repetível, acumula em .flags) e/ou
                  --approach "texto" (fecha o approach: pendente do brief); pelo menos um
  retro           relatório de calibração (E10): agrega o log da janela (--days N) —
                  override rate, gates, smells, desfechos, critério de promoção
  brief           brief de projeto (E8): estado situacional carimbado (ts, HEAD, wtree, sessão)
                  sem flag lê com veredito de freshness · --write grava (narrativa via stdin
                  ou --file) · --auto gera esqueleto do git · --path só o caminho — bash puro, sem Bun

exit: 0 ok · 1 validação · 2 ambiente quebrado
U
}

die() { # die <categoria> <mensagem> <fix> <exit>
  printf 'maestro: %s: %s (fix: %s)\n' "$1" "$2" "$3" >&2
  exit "$4"
}

# ------------------------------------------------------------------ relatório do doctor

CI=0
C_OK=''; C_WARN=''; C_FAIL=''; C_OFF=''
N_CHECKS=0; N_WARN=0; N_SKIP=0; FAIL_ENV=0; FAIL_VAL=0
CAP_BINDINGS_OK=0; CAP_SKILL_ROOTS=0   # E7/S-705: fatos capturados p/ capabilities.json
CAP_INJECTION_BYTES=0                  # E7/S-703: conta real da injeção do SessionStart
CAP_INSTALL_REGISTERED=0; CAP_INSTALL_DIVERGENT=0   # E7/S-710: instalação vs repo
CAP_INSTALL_REPO_LIVE=0                # E7/S-710: o repo é o CLAUDE_PLUGIN_ROOT vivo?

report() { # report <ok|warn|skip|fail_env|fail_val> <descrição> [detalhe]
  local st="$1" desc="$2" det="${3:-}"
  N_CHECKS=$((N_CHECKS + 1))
  [[ -n "$det" ]] && desc="$desc — $det"
  case "$st" in
    ok)   [[ $CI -eq 1 ]] || printf '%sok  %s %s\n' "$C_OK" "$C_OFF" "$desc" ;;
    warn) N_WARN=$((N_WARN + 1)); printf '%swarn%s %s\n' "$C_WARN" "$C_OFF" "$desc" ;;
    skip) N_SKIP=$((N_SKIP + 1)); printf 'skip %s\n' "$desc" ;;
    fail_env) FAIL_ENV=1; printf '%sFAIL%s %s\n' "$C_FAIL" "$C_OFF" "$desc" ;;
    fail_val) FAIL_VAL=1; printf '%sFAIL%s %s\n' "$C_FAIL" "$C_OFF" "$desc" ;;
  esac
}

check() { # check <env|val> <descrição> <comando...>
  local cls="$1" desc="$2"; shift 2
  if "$@" >/dev/null 2>&1; then report ok "$desc"; else report "fail_$cls" "$desc"; fi
}

# --------------------------------------------------------------- parsers disponíveis

has() { command -v "$1" >/dev/null 2>&1; }

json_parser() { # jq > bun > none — "none" vira skip, jamais FAIL de conteúdo (review P2-7)
  if has jq; then printf 'jq\n'
  elif has bun; then printf 'bun\n'
  else printf 'none\n'; fi
}

json_valid() { # json_valid <arquivo>
  case "$(json_parser)" in
    jq)  jq -e . "$1" >/dev/null 2>&1 ;;
    bun) MAESTRO_JSON="$1" bun -e \
           'JSON.parse(require("fs").readFileSync(process.env.MAESTRO_JSON,"utf8"))' >/dev/null 2>&1 ;;
    *)   return 2 ;;
  esac
}

# --------------------------------------------------------------- leitura do hooks.json

hooks_json_events() { # lista os eventos de topo declarados em .hooks
  local f="$1"
  if has jq; then
    jq -r '.hooks // {} | keys[]' "$f" 2>/dev/null
  else
    # modo degradado (sem jq): procura os eventos conhecidos como chave
    local ev
    for ev in "${EXPECTED_EVENTS[@]}"; do
      grep -qE "\"$ev\"[[:space:]]*:" "$f" && printf '%s\n' "$ev"
    done
    return 0
  fi
}

hooks_json_commands() { # lista todo .command declarado, em qualquer profundidade
  local f="$1"
  if has jq; then
    jq -r '[.. | objects | select(has("command")) | .command] | .[]' "$f" 2>/dev/null
  else
    grep -oE '"command"[[:space:]]*:[[:space:]]*"[^"]*"' "$f" 2>/dev/null \
      | sed -E 's/.*:[[:space:]]*"(.*)"$/\1/'
  fi
}

hooks_json_pretooluse_matchers() {
  local f="$1"
  if has jq; then
    jq -r '.hooks.PreToolUse // [] | .[] | (.matcher // "")' "$f" 2>/dev/null
  else
    grep -oE '"matcher"[[:space:]]*:[[:space:]]*"[^"]*"' "$f" 2>/dev/null \
      | sed -E 's/.*:[[:space:]]*"(.*)"$/\1/'
  fi
}

expand_plugin_root() { # ${CLAUDE_PLUGIN_ROOT}/x → <repo>/x
  local s="$1"
  s="${s//\$\{CLAUDE_PLUGIN_ROOT\}/$REPO_DIR}"
  s="${s//\$CLAUDE_PLUGIN_ROOT/$REPO_DIR}"
  printf '%s\n' "$s"
}

check_hooks_registry() { # AC da S-103: "detecta hook não registrado"
  local f="$REPO_DIR/hooks/hooks.json"

  if [[ ! -f "$f" ]]; then
    report fail_env "hooks.json presente" "$f não existe — plugin sem registro de hooks"
    return
  fi
  report ok "hooks.json presente"

  local rc=0; json_valid "$f" || rc=$?
  if [[ $rc -eq 2 ]]; then
    report skip "hooks.json é JSON válido" "nem jq nem bun disponíveis para parsear"
  elif [[ $rc -ne 0 ]]; then
    report fail_val "hooks.json é JSON válido" "parse falhou"
    return
  else
    report ok "hooks.json é JSON válido"
  fi

  # 1) os 4 eventos esperados existem
  local events missing=() ev
  events=$(hooks_json_events "$f" || true)
  for ev in "${EXPECTED_EVENTS[@]}"; do
    printf '%s\n' "$events" | grep -qx "$ev" || missing+=("$ev")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    report fail_val "hooks.json registra os 4 eventos esperados" \
      "faltando: ${missing[*]} (plugin instalado com hook não registrado)"
  else
    report ok "hooks.json registra os 4 eventos esperados"
  fi

  # 2) matcher do PreToolUse cobre Edit|Write|MultiEdit
  local matchers tool tok found uncovered=()
  matchers=$(hooks_json_pretooluse_matchers "$f" || true)
  if [[ -z "${matchers//[[:space:]]/}" ]]; then
    # matcher vazio/ausente = casa com toda ferramenta; só é válido se o evento existe
    if printf '%s\n' "$events" | grep -qx PreToolUse; then
      report warn "matcher do PreToolUse cobre Edit|Write|MultiEdit" \
        "matcher ausente — o hook roda para TODA ferramenta"
    fi
  else
    for tool in "${EXPECTED_MATCHER_TOOLS[@]}"; do
      found=0
      while IFS= read -r m; do
        [[ -z "$m" ]] && continue
        [[ "$m" == '*' || "$m" == '.*' ]] && { found=1; break; }
        while IFS= read -r tok; do
          tok="${tok//[[:space:]]/}"
          [[ "$tok" == "$tool" ]] && { found=1; break; }
        done < <(printf '%s\n' "$m" | tr '|' '\n')
        [[ $found -eq 1 ]] && break
      done <<<"$matchers"
      [[ $found -eq 0 ]] && uncovered+=("$tool")
    done
    if [[ ${#uncovered[@]} -gt 0 ]]; then
      report fail_val "matcher do PreToolUse cobre Edit|Write|MultiEdit" \
        "não coberto(s): ${uncovered[*]}"
    else
      report ok "matcher do PreToolUse cobre Edit|Write|MultiEdit"
    fi
  fi

  # 3) todo command resolve para arquivo existente e executável
  local cmds n=0 bad=()
  cmds=$(hooks_json_commands "$f" || true)
  while IFS= read -r c; do
    [[ -z "$c" ]] && continue
    n=$((n + 1))
    local path bin
    path=$(expand_plugin_root "$c")
    bin="${path%% *}"   # ignora argumentos eventuais
    if [[ ! -e "$bin" ]]; then
      bad+=("$(basename -- "$bin"): inexistente")
    elif [[ ! -x "$bin" ]]; then
      bad+=("$(basename -- "$bin"): sem bit de execução")
    fi
  done <<<"$cmds"

  if [[ $n -eq 0 ]]; then
    report fail_val "hooks.json: commands resolvem para script executável" \
      "nenhum command declarado — plugin instalado com ZERO hooks ativos"
  elif [[ ${#bad[@]} -gt 0 ]]; then
    report fail_env "hooks.json: commands resolvem para script executável" "${bad[*]}"
  else
    report ok "hooks.json: $n commands resolvem para script executável"
  fi
}

# ------------------------------------------------------- validação do routing-table.yaml

yaml_check_bun() { # imprime o motivo no stdout; rc 0 = válido
  MAESTRO_YAML="$1" bun -e '
const fs = require("fs");
const p = process.env.MAESTRO_YAML;
let d;
try {
  d = Bun.YAML.parse(fs.readFileSync(p, "utf8"));
} catch (e) {
  console.log("YAML inválido: " + String((e && e.message) || e).split("\n")[0]);
  process.exit(1);
}
if (Array.isArray(d) && d.length === 1) d = d[0];
const isObj = (v) => v !== null && typeof v === "object" && !Array.isArray(v);
const errs = [];
if (!isObj(d)) {
  errs.push("raiz do YAML não é um mapa");
} else {
  if (d.version === undefined || d.version === null) errs.push("chave version ausente");
  if (!isObj(d.gate)) {
    errs.push("chave gate ausente ou não é mapa");
  } else {
    if (d.gate.mode !== "warn" && d.gate.mode !== "block")
      errs.push("gate.mode deve ser warn|block (achado: " + JSON.stringify(d.gate.mode) + ")");
    if (!isObj(d.gate.allowlist)) errs.push("gate.allowlist ausente");
    if (!isObj(d.gate.denylist)) errs.push("gate.denylist ausente");
    else {
      // paths = universais; self_paths = autoproteção ancorada no plugin root.
      // Perder self_paths abriria o gate, o CLI e o roster à reescrita por agente.
      const nonEmpty = (v) => Array.isArray(v) && v.length > 0;
      if (!nonEmpty(d.gate.denylist.paths))
        errs.push("gate.denylist.paths ausente ou vazio");
      if (!nonEmpty(d.gate.denylist.self_paths))
        errs.push("gate.denylist.self_paths ausente ou vazio (autoproteção desarmada)");
    }
  }
  if (!isObj(d.workflows) || Object.keys(d.workflows).length === 0)
    errs.push("workflows ausente ou vazio");
  // v2 (S-401): o bloco `bindings` deixou de ser opcional — é ele que faz o
  // step referenciar comando existente. A checagem de que CADA step tem
  // binding, e de que cada alvo resolve no ambiente, é do check_bindings
  // (bash puro, roda também sem Bun).
  if (d.bindings !== undefined && !isObj(d.bindings))
    errs.push("bindings existe mas não é mapa");
  if (Number(d.version) >= 2 && !isObj(d.bindings))
    errs.push("version >= 2 exige o bloco bindings (S-401)");
  if (!Array.isArray(d.routes) || d.routes.length === 0) errs.push("routes ausente ou vazio");
}
if (errs.length) { console.log(errs.join("; ")); process.exit(1); }
process.exit(0);
' 2>&1
}

yaml_check_bash() { # checagem estrutural, sem Bun; imprime o motivo no stdout
  local f="$1" errs=() bal
  grep -qE '^version:[[:space:]]*[^[:space:]#]' "$f" || errs+=("chave version ausente")
  grep -qE '^gate:[[:space:]]*(#.*)?$'          "$f" || errs+=("chave gate ausente")
  grep -qE '^[[:space:]]+mode:[[:space:]]*(warn|block)[[:space:]]*(#.*)?$' "$f" \
    || errs+=("gate.mode deve ser warn|block")
  grep -qE '^[[:space:]]+allowlist:' "$f" || errs+=("gate.allowlist ausente")
  grep -qE '^[[:space:]]+denylist:'  "$f" || errs+=("gate.denylist ausente")
  grep -qE '^[[:space:]]+self_paths:[[:space:]]*\[[^]]' "$f" \
    || errs+=("gate.denylist.self_paths ausente ou vazio (autoproteção desarmada)")
  grep -qE '^workflows:'             "$f" || errs+=("workflows ausente")
  grep -qE '^routes:'                "$f" || errs+=("routes ausente")
  if grep -qE '^version:[[:space:]]*[2-9][0-9]*[[:space:]]*(#.*)?$' "$f" \
     && ! grep -qE '^bindings:' "$f"; then
    errs+=("version >= 2 exige o bloco bindings (S-401)")
  fi
  grep -qE "^$(printf '\t')"         "$f" && errs+=("indentação com TAB (YAML proíbe)")
  bal=$(awk '{ l=$0; sub(/^#.*/,"",l); sub(/[ \t]#.*/,"",l);
               ob+=gsub(/\[/,"[",l); cb+=gsub(/\]/,"]",l);
               oc+=gsub(/\{/,"{",l); cc+=gsub(/\}/,"}",l) }
             END { print (ob-cb) "," (oc-cc) }' "$f")
  [[ "$bal" != "0,0" ]] && errs+=("colchetes/chaves de fluxo desbalanceados ($bal)")
  if [[ ${#errs[@]} -gt 0 ]]; then
    local IFS='; '; printf '%s\n' "${errs[*]}"; return 1
  fi
  return 0
}

check_routing_table() { # AC da S-103: "detecta YAML inválido"
  local f="$REPO_DIR/config/routing-table.yaml" out
  if [[ ! -f "$f" ]]; then
    report fail_env "routing-table.yaml presente" "$f não existe"
    return
  fi
  report ok "routing-table.yaml presente"

  if has bun; then
    if out=$(yaml_check_bun "$f"); then
      report ok "routing-table.yaml: schema válido (parse real via Bun.YAML)"
    else
      report fail_val "routing-table.yaml: schema válido" "${out:-parse falhou}"
    fi
  else
    if out=$(yaml_check_bash "$f"); then
      report ok "routing-table.yaml: schema válido (checagem estrutural — Bun ausente)"
    else
      report fail_val "routing-table.yaml: schema válido (sem Bun)" "$out"
    fi
  fi
}

# ------------------------------------------------------------- bindings (E4/S-401)
#
# A AC da S-401 é literal: "cada step referencia comando existente no ambiente".
# Um binding que aponta para skill desinstalada é PIOR que binding nenhum — a
# injeção manda o Claude rodar algo que não existe, e ele improvisa em silêncio.
# Por isso o doctor resolve cada alvo de verdade no disco.
#
# Classificação (API_SPEC §3) — a linha divisória é DE QUEM É O ARQUIVO:
#   rc 1 (conteúdo) .. step sem binding, alvo malformado, `native:` fora do
#                      vocabulário e `agent:` fora do roster. O roster é
#                      versionado DENTRO do plugin: binding e agents/ em
#                      desacordo é incoerência entre dois arquivos do repo.
#   rc 2 (ambiente) .. `skill:` que não está instalada. Skill vive fora do
#                      repo, em ~/.claude — é dependência, não conteúdo.
#
# Ambiente sem NENHUM diretório de skills (CI limpo, container) não é
# instalação quebrada: vira `skip`, com o motivo dito. Fingir FAIL ali seria
# ruído; fingir ok seria mentira.
#
# `native:` é vocabulário FECHADO — não dá para provar no disco que o plan mode
# existe, então o que se valida é que ninguém inventou um native novo sem
# emendar o DATA_MODEL §1.
# Costura de teste: MAESTRO_SKILL_DIRS (lista separada por ':') substitui as
# raízes de busca de skill — é como o teste prova o skip do CI e o FAIL de skill
# ausente sem depender do ~/.claude real.
NATIVE_VOCAB=' plan-mode '

skill_roots() { # raízes onde uma skill pode estar instalada (uma por linha)
  local roots=() r
  if [[ -n "${MAESTRO_SKILL_DIRS:-}" ]]; then
    local IFS=':'
    for r in $MAESTRO_SKILL_DIRS; do [[ -n "$r" && -d "$r" ]] && roots+=("$r"); done
  else
    shopt -s nullglob
    for r in "$HOME/.claude/skills" "${CLAUDE_PROJECT_DIR:-$PWD}/.claude/skills" \
             "$REPO_DIR/skills" "$HOME"/.claude/plugins/cache/*/*/*/skills; do
      [[ -d "$r" ]] && roots+=("$r")
    done
    shopt -u nullglob
  fi
  [[ ${#roots[@]} -gt 0 ]] && printf '%s\n' "${roots[@]}"
  return 0
}

skill_exists() { # skill_exists <nome> — SKILL.md em diretório, ou <nome>.md solto
  local n="$1" r
  while IFS= read -r r; do
    [[ -n "$r" ]] || continue
    [[ -f "$r/$n/SKILL.md" || -f "$r/$n.md" ]] && return 0
  done < <(skill_roots)
  return 1
}

yaml_workflow_steps() { # → "<workflow>\t<step>" por linha
  awk '
    /^[^ \t#]/ { inwf = ($0 ~ /^workflows:[ \t]*(#.*)?$/) ? 1 : 0; next }
    inwf && /^[ \t]+[a-z][A-Za-z0-9_-]*:/ {
      v = $0; sub(/[ \t]*#.*$/, "", v)
      i = index(v, ":"); name = substr(v, 1, i - 1); rest = substr(v, i + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", name)
      if (match(rest, /steps:[ \t]*\[[^]]*\]/) == 0) next
      s = substr(rest, RSTART, RLENGTH); sub(/steps:[ \t]*\[/, "", s); sub(/\]$/, "", s)
      n = split(s, a, ",")
      for (j = 1; j <= n; j++) {
        gsub(/[ \t"]/, "", a[j])
        if (a[j] != "") print name "\t" a[j]
      }
    }
  ' "$1" 2>/dev/null
}

yaml_bindings() { # → "<step>\t<alvo> [<alvo>...]" por linha
  awk '
    /^[^ \t#]/ { inb = ($0 ~ /^bindings:[ \t]*(#.*)?$/) ? 1 : 0; next }
    inb && /^[ \t]+[a-z][A-Za-z0-9_-]*:/ {
      v = $0; sub(/[ \t]*#.*$/, "", v)
      i = index(v, ":"); k = substr(v, 1, i - 1); r = substr(v, i + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", k)
      gsub(/[][,"]/, " ", r); gsub(/[ \t]+/, " ", r)
      gsub(/^ | $/, "", r)
      if (k != "" && r != "") print k "\t" r
    }
  ' "$1" 2>/dev/null
}

check_bindings() {
  local f="$REPO_DIR/config/routing-table.yaml"
  # YAML ausente/ilegível já foi reportado por check_routing_table — não duplica.
  [[ -f "$f" && -r "$f" ]] || return 0

  local steps_lines bind_lines
  steps_lines=$(yaml_workflow_steps "$f")
  bind_lines=$(yaml_bindings "$f")

  if [[ -z "${steps_lines//[[:space:]]/}" ]]; then
    report ok "bindings: nenhum workflow com steps (nada a bindar)"
    return
  fi

  local wf st tgt tok
  # 1) todo step de workflow tem binding
  local unbound=() seen_step=' '
  while IFS=$'\t' read -r wf st; do
    [[ -n "$st" ]] || continue
    [[ "$seen_step" == *" $wf/$st "* ]] && continue
    seen_step+="$wf/$st "
    tgt=$(printf '%s\n' "$bind_lines" | awk -F'\t' -v k="$st" '$1 == k { print $2; exit }')
    [[ -n "$tgt" ]] || unbound+=("$wf → $st")
  done <<<"$steps_lines"

  if [[ ${#unbound[@]} -gt 0 ]]; then
    report fail_val "bindings: todo step de workflow tem binding (AC S-401)" \
      "sem binding: $(join_semi "${unbound[@]}") (fix: declare o step em bindings: no routing-table.yaml)"
  else
    report ok "bindings: todo step de workflow tem binding"
  fi

  # 2) cada alvo é bem-formado e resolve no ambiente
  local malformed=() missing=() badagent=() n_ok=0 has_skill=0
  local roots_n; roots_n=$(skill_roots | grep -c . || true)
  CAP_SKILL_ROOTS=$roots_n
  while IFS=$'\t' read -r st tgt; do
    [[ -n "$st" && -n "$tgt" ]] || continue
    for tok in $tgt; do
      if [[ ! "$tok" =~ ^(skill|agent|native):[A-Za-z0-9][A-Za-z0-9._-]{0,47}$ ]]; then
        malformed+=("$st → '$tok' (use skill:|agent:|native:)")
        continue
      fi
      case "$tok" in
        agent:*)
          if [[ -f "$AGENTS_DIR/${tok#agent:}.md" ]]; then n_ok=$((n_ok + 1))
          else badagent+=("$st → $tok (não há ${tok#agent:}.md no roster)"); fi ;;
        native:*)
          if [[ "$NATIVE_VOCAB" == *" ${tok#native:} "* ]]; then n_ok=$((n_ok + 1))
          else malformed+=("$st → $tok fora do vocabulário native ($NATIVE_VOCAB)"); fi ;;
        skill:*)
          has_skill=1
          if [[ $roots_n -eq 0 ]]; then :
          elif skill_exists "${tok#skill:}"; then n_ok=$((n_ok + 1))
          else missing+=("$st → $tok (skill não instalada)"); fi ;;
      esac
    done
  done <<<"$bind_lines"
  CAP_BINDINGS_OK=$n_ok

  if [[ ${#malformed[@]} -gt 0 ]]; then
    report fail_val "bindings: alvos no formato skill:|agent:|native:" "$(join_semi "${malformed[@]}")"
  fi
  if [[ ${#badagent[@]} -gt 0 ]]; then
    report fail_val "bindings: alvos agent: existem no roster" \
      "$(join_semi "${badagent[@]}") (fix: corrija o binding ou adicione o agente em agents/)"
  fi
  if [[ $has_skill -eq 1 && $roots_n -eq 0 ]]; then
    report skip "bindings: alvos resolvem no ambiente" \
      "nenhum diretório de skills neste ambiente (CI?) — alvos skill: não verificados"
  elif [[ ${#missing[@]} -gt 0 ]]; then
    report fail_env "bindings: alvos skill: instalados no ambiente" \
      "$(join_semi "${missing[@]}") (fix: instale a skill ou corrija o binding)"
  elif [[ ${#malformed[@]} -eq 0 && ${#badagent[@]} -eq 0 ]]; then
    report ok "bindings: $n_ok alvo(s) resolvem no ambiente ($roots_n raiz(es) de skill)"
  fi

  # 3) binding declarado que nenhum workflow usa — aviso: é tabela apodrecendo
  local orphan=()
  while IFS=$'\t' read -r st tgt; do
    [[ -n "$st" ]] || continue
    printf '%s\n' "$steps_lines" | awk -F'\t' -v k="$st" '$2 == k { found = 1 } END { exit !found }' \
      || orphan+=("$st")
  done <<<"$bind_lines"
  [[ ${#orphan[@]} -gt 0 ]] \
    && report warn "bindings: todo binding é usado por algum workflow" \
         "declarado(s) e nunca usado(s): $(join_semi "${orphan[@]}")"
  return 0
}

# --------------------------------------------- drift + envelope (E7/S-705, S-706)

skill_path() { # skill_path <nome> — caminho resolvido (primeira raiz que tiver)
  local n="$1" r
  while IFS= read -r r; do
    [[ -n "$r" ]] || continue
    if [[ -f "$r/$n/SKILL.md" ]]; then printf '%s\n' "$r/$n/SKILL.md"; return 0; fi
    if [[ -f "$r/$n.md" ]]; then printf '%s\n' "$r/$n.md"; return 0; fi
  done < <(skill_roots)
  return 1
}

check_binding_drift() { # S-706 (P0.2 do ECC audit): resolução estável entre doctors
  # Snapshot alvo→caminho→sha256 em $MAESTRO_HOME (estado local; NÃO é o log).
  # Drift = o MESMO alvo resolvendo para caminho ou conteúdo diferente do último
  # doctor — a classe do incidente do --prefix (2026-08-10, decision-log), que
  # quebrou 3 bindings em silêncio. Sempre AVISO, nunca falha: atualização
  # legítima de pack também é drift — o valor é ficar VISÍVEL; o snapshot sempre
  # avança, então cada mudança avisa exatamente uma vez.
  local f="$REPO_DIR/config/routing-table.yaml"
  [[ -f "$f" && -r "$f" ]] || return 0
  has sha256sum || { report skip "bindings: drift de resolução" "requer sha256sum"; return 0; }
  mkdir -p "$MAESTRO_HOME" 2>/dev/null || return 0
  local snap="$MAESTRO_HOME/bindings-snapshot.tsv"
  local bind_lines; bind_lines=$(yaml_bindings "$f")
  local roots_n; roots_n=$(skill_roots | grep -c . || true)

  local cur='' st tgt tok p h
  while IFS=$'\t' read -r st tgt; do
    [[ -n "$st" && -n "$tgt" ]] || continue
    for tok in $tgt; do
      case "$tok" in
        agent:*) p="$AGENTS_DIR/${tok#agent:}.md"; [[ -f "$p" ]] || continue ;;
        skill:*) [[ $roots_n -gt 0 ]] || continue
                 p=$(skill_path "${tok#skill:}") || continue ;;
        *) continue ;;  # native: não tem arquivo; malformado é assunto do check_bindings
      esac
      h=$(sha256sum -- "$p" 2>/dev/null | awk '{print $1}') || continue
      [[ -n "$h" ]] && cur+="$tok	$p	$h"$'\n'
    done
  done <<<"$bind_lines"
  cur=$(printf '%s' "$cur" | sort -u)
  [[ -n "$cur" ]] || return 0

  if [[ ! -f "$snap" ]]; then
    if printf '%s\n' "$cur" > "$snap" 2>/dev/null; then
      report ok "bindings: snapshot de resolução inicial gravado ($(printf '%s\n' "$cur" | grep -c .) alvo(s))"
    else
      report warn "bindings: drift de resolução" "não consegui gravar o snapshot em $MAESTRO_HOME"
    fi
    return 0
  fi

  local drift=() otok op oh line np nh
  while IFS=$'\t' read -r otok op oh; do
    [[ -n "$otok" && -n "$op" && -n "$oh" ]] || continue
    line=$(printf '%s\n' "$cur" | awk -F'\t' -v k="$otok" '$1 == k { print; exit }')
    [[ -n "$line" ]] || continue   # alvo saiu da tabela/ambiente → assunto do check_bindings
    np=$(printf '%s' "$line" | cut -f2); nh=$(printf '%s' "$line" | cut -f3)
    if [[ "$np" != "$op" ]]; then drift+=("binding-resolution-drift: $otok (caminho mudou)")
    elif [[ "$nh" != "$oh" ]]; then drift+=("binding-resolution-drift: $otok (conteúdo mudou)")
    fi
  done < "$snap"

  printf '%s\n' "$cur" > "$snap" 2>/dev/null || true
  if [[ ${#drift[@]} -gt 0 ]]; then
    report warn "bindings: resolução estável desde o último doctor" \
      "$(join_semi "${drift[@]}") — atualização deliberada? o aviso some no próximo doctor"
  else
    report ok "bindings: resolução estável desde o último doctor (drift zero)"
  fi
}

check_vendor_integrity() { # S-706: vendor/ verificado offline contra manifesto pinado
  local man="${MAESTRO_VENDOR_MANIFEST:-$REPO_DIR/config/vendor.sha256}"
  [[ -d "$REPO_DIR/vendor" ]] || { report ok "vendor/: ausente (nada a verificar)"; return 0; }
  has sha256sum || { report skip "vendor/: integridade vs manifesto" "requer sha256sum"; return 0; }
  if [[ ! -f "$man" ]]; then
    report warn "vendor/: manifesto de integridade ausente" \
      "gere: (cd <repo> && find vendor -type f | sort | xargs sha256sum > config/vendor.sha256)"
    return 0
  fi
  if (cd "$REPO_DIR" && sha256sum --check --quiet "$man" >/dev/null 2>&1); then
    report ok "vendor/: íntegro vs manifesto ($(grep -c . "$man") arquivo(s))"
  else
    report fail_val "vendor/: íntegro vs manifesto" \
      "difere de config/vendor.sha256 — vendor/ é read-only; atualização deliberada? regenere o manifesto no mesmo commit"
  fi
}

check_plugin_install() { # S-710: cópia instalada do plugin divergente deste repo
  # O Claude Code resolve `${CLAUDE_PLUGIN_ROOT}` (o que o hooks.json usa) a
  # partir de ~/.claude/plugins, e o `installPath` de installed_plugins.json
  # costuma ser uma CÓPIA em cache, congelada no instante da instalação. A
  # pergunta que decide a severidade é: QUEM EXECUTA?
  #
  #   - Marketplace `source: directory` com `installLocation` = este repo: o
  #     plugin declara `"source": "./"` (relativo à raiz do marketplace), logo o
  #     root vivo é o REPO. Medido ponta a ponta em 2026-08-18 — sessão headless
  #     nova injeta o conteúdo do repo, e a cópia em cache (pré-E7, mesma versão
  #     1.0.4) não produz aquelas seções. Cópia divergente aí é INERTE: não
  #     executa, e avisar seria ruído a cada commit de quem dogfooda o repo.
  #   - Sem esse marketplace, quem executa é o installPath registrado — e então
  #     divergir é ROLLBACK SILENCIOSO: tabela e hooks velhos, sem sinal nenhum.
  #     A classe do incidente do --prefix (2026-08-10), um andar acima.
  #
  # Nunca falha: o repo é a verdade e o pior caso aqui é um aviso.
  local base="${MAESTRO_PLUGINS_DIR:-$HOME/.claude/plugins}"
  local reg="$base/installed_plugins.json"
  if [[ ! -f "$reg" || ! -r "$reg" ]]; then
    report ok "instalação do plugin: sem registro do Claude Code (repo usado direto)"
    return 0
  fi
  has jq  || { report skip "instalação do plugin vs repo" "requer jq";  return 0; }
  has cmp || { report skip "instalação do plugin vs repo" "requer cmp"; return 0; }

  local name='maestro' pj="$REPO_DIR/.claude-plugin/plugin.json"
  [[ -f "$pj" ]] && name=$(jq -r '.name // "maestro"' "$pj" 2>/dev/null) || true
  [[ -n "$name" && "$name" != "null" ]] || name='maestro'

  # O repo é a raiz viva? (marketplace de diretório apontando para cá)
  local repo_real; repo_real=$(cd -P -- "$REPO_DIR" && pwd)
  local mk="$base/known_marketplaces.json" repo_is_live=0 loc loc_real
  if [[ -f "$mk" && -r "$mk" ]]; then
    while IFS= read -r loc; do
      [[ -n "$loc" && -d "$loc" ]] || continue
      loc_real=$(cd -P -- "$loc" 2>/dev/null && pwd) || continue
      [[ "$loc_real" == "$repo_real" ]] && repo_is_live=1
    done < <(jq -r '(to_entries // [])[]
        | select((.value.source.source // "") == "directory")
        | .value.installLocation // empty' "$mk" 2>/dev/null || true)
  fi
  CAP_INSTALL_REPO_LIVE=$repo_is_live

  local paths
  paths=$(jq -r --arg n "$name" '
      (.plugins // {}) | to_entries[]
      | select(.key == $n or (.key | startswith($n + "@")))
      | (.value | if type == "array" then .[] else . end)
      | .installPath // empty' "$reg" 2>/dev/null) || paths=''
  if [[ -z "$paths" ]]; then
    report ok "instalação do plugin: '$name' não registrado (repo usado direto)"
    return 0
  fi

  # Arquivos que DEFINEM comportamento: se algum destes difere, a cópia roda
  # outro Maestro. Docs e testes divergirem é irrelevante e não vira ruído.
  local files=(hooks/hooks.json hooks/session-start.sh hooks/pre-tool-gate.sh
               hooks/user-prompt-submit.sh hooks/lib/common.sh
               config/routing-table.yaml bin/maestro .claude-plugin/plugin.json)
  local stale=() n_reg=0 p p_real rel diff
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    n_reg=$((n_reg + 1))
    if [[ ! -d "$p" ]]; then stale+=("$p (ausente)"); continue; fi
    p_real=$(cd -P -- "$p" 2>/dev/null && pwd) || p_real="$p"
    [[ "$p_real" == "$repo_real" ]] && continue   # registro aponta para o repo
    diff=()
    for rel in "${files[@]}"; do
      cmp -s -- "$REPO_DIR/$rel" "$p/$rel" || diff+=("$rel")
    done
    # set -e: o sufixo sai de um `if`, nunca de um `$( ... && ... )` — comando
    # substituto que devolve 1 dentro de atribuição derruba o doctor inteiro.
    if (( ${#diff[@]} > 0 )); then
      local more=''
      if (( ${#diff[@]} > 1 )); then more=" (+$(( ${#diff[@]} - 1 )))"; fi
      stale+=("$p_real: ${#diff[@]} arquivo(s) — ${diff[0]}$more")
    fi
  done <<<"$paths"

  CAP_INSTALL_REGISTERED=$n_reg
  CAP_INSTALL_DIVERGENT=${#stale[@]}
  if (( ${#stale[@]} == 0 )); then
    report ok "instalação do plugin: $n_reg registro(s) sem cópia divergente"
  elif (( repo_is_live == 1 )); then
    report ok "instalação do plugin: o repo é a raiz viva (${#stale[@]} cópia(s) em cache inerte(s))" \
      "marketplace de diretório aponta para $repo_real — a cópia registrada não executa"
  else
    report warn "instalação do plugin: cópia registrada idêntica a este repo" \
      "$(join_semi "${stale[@]}") — sessão que resolver por essa cópia roda Maestro antigo (fix: reinstale o plugin apontando para $repo_real, ou remova a cópia)"
  fi
}

check_evidence() { # E13: ledger de evidência — recibos parseáveis, nunca fingidos
  local ed="$MAESTRO_HOME/evidence" f bad=() n=0
  [[ -d "$ed" ]] || { report ok "evidência: ledger vazio (registre com maestro evidence --record)"; return 0; }
  shopt -s nullglob
  for f in "$ed"/*; do
    n=$(( n + 1 ))
    awk 'NR==1 { exit ($0 == "schema=maestro-evidence-v1") ? 0 : 1 }' "$f" 2>/dev/null \
      || { bad+=("${f##*/}"); continue; }
    grep -Eq '^epoch=[0-9]+$' "$f" 2>/dev/null || bad+=("${f##*/}")
  done
  shopt -u nullglob
  if (( n == 0 )); then report ok "evidência: ledger vazio (registre com maestro evidence --record)"
  elif [[ ${#bad[@]} -gt 0 ]]; then
    report warn "evidência: $(( n - ${#bad[@]} )) recibo(s) ok, ${#bad[@]} ilegível(is)" \
      "${bad[*]} — regrave com maestro evidence --record"
  else
    report ok "evidência: $n recibo(s) parseável(is) no ledger"
  fi
}

check_consents() { # E10: consentimento ativo é estado ELEVADO — sempre visível
  local cdir="$MAESTRO_HOME/consents" f sc exp now active=() n_exp=0
  [[ -d "$cdir" ]] || { report ok "consentimentos: nenhum ativo (denylist integral)"; return 0; }
  now=$(date +%s 2>/dev/null) || now=0
  shopt -s nullglob
  for f in "$cdir"/*; do
    sc="${f##*/}"
    exp=$(awk -F= '/^expires=/ { print $2; exit }' "$f" 2>/dev/null)
    if [[ "$exp" =~ ^[0-9]+$ ]] && (( exp > now )); then
      active+=("$sc ($(( (exp - now) / 60 ))min)")
    else
      rm -f "$f" 2>/dev/null && n_exp=$(( n_exp + 1 )) || :
    fi
  done
  shopt -u nullglob
  if [[ ${#active[@]} -gt 0 ]]; then
    report warn "consentimentos ATIVOS: ${active[*]}" \
      "a IA pode editar esses escopos — revogue com maestro consent --revoke se não for intencional"
  else
    report ok "consentimentos: nenhum ativo (denylist integral$( ((n_exp>0)) && printf '; %s expirado(s) removido(s)' "$n_exp" ))"
  fi
}

check_commands() { # E9/S-904: slash commands do plugin — frontmatter mínimo
  local cd_="$REPO_DIR/commands" f bad=() n=0
  [[ -d "$cd_" ]] || { report ok "commands/: nenhum (plugin sem slash command)"; return 0; }
  shopt -s nullglob
  for f in "$cd_"/*.md; do
    n=$(( n + 1 ))
    awk 'NR==1 { exit ($0 == "---") ? 0 : 1 }' "$f" 2>/dev/null \
      || { bad+=("${f##*/} (sem frontmatter)"); continue; }
    awk 'NR>1 && /^---$/ { exit } /^description:/ { found=1 } END { exit !found }' "$f" 2>/dev/null \
      || bad+=("${f##*/} (sem description)")
  done
  shopt -u nullglob
  if (( n == 0 )); then report ok "commands/: nenhum (plugin sem slash command)"
  elif (( ${#bad[@]} > 0 )); then
    report fail_val "commands/: frontmatter válido" "${bad[*]} — comando sem description não aparece no /help"
  else
    report ok "commands/: $n slash command(s) com frontmatter válido"
  fi
}

check_habit_guides() { # E9: todo sensor com guia — sensor sem guia é métrica nua
  local gd="$REPO_DIR/config/habit-guides" eng="$REPO_DIR/hooks/lib/habit-sensors.awk"
  [[ -f "$eng" ]] || { report skip "habit guides" "motor de sensores ausente"; return 0; }
  local smells missing=() sm
  smells=$(grep -oE 'emit\("[a-z-]+"' "$eng" 2>/dev/null | sed 's/emit("//; s/"//' | awk '!seen[$0]++')
  smells+=$'\n'"test-gap"$'\n'"doc-governed"$'\n'"regencia"   # sensores de sessão: vivem no hook, não no awk
  while IFS= read -r sm; do
    [[ -n "$sm" ]] || continue
    [[ -s "$gd/$sm.md" ]] || missing+=("$sm")
  done <<<"$smells"
  if [[ ${#missing[@]} -gt 0 ]]; then
    report fail_val "habit guides: todo sensor tem guia" \
      "sem guia: ${missing[*]} (sensor sem guia é linter cru — escreva config/habit-guides/<smell>.md)"
  else
    report ok "habit guides: $(grep -c . <<<"$smells") sensor(es), todos com guia"
  fi
}

check_briefs() { # E8: briefs de projeto — carimbos válidos, staleness visível
  local bdir="$MAESTRO_HOME/briefs" f n=0 bad=() newest=0 e
  [[ -d "$bdir" ]] || { report ok "briefs de projeto: nenhum (crie com maestro brief --write)"; return 0; }
  shopt -s nullglob
  for f in "$bdir"/*.md; do
    n=$(( n + 1 ))
    if ! awk 'NR==1 { exit ($0 == "<!-- maestro-brief v1") ? 0 : 1 }' "$f" 2>/dev/null; then
      bad+=("${f##*/} (cabeçalho)"); continue
    fi
    e=$(awk 'NR>8 { exit } /^epoch: / { print substr($0,8); exit }' "$f" 2>/dev/null)
    if [[ ! "$e" =~ ^[0-9]+$ ]]; then bad+=("${f##*/} (epoch)"); continue; fi
    (( e > newest )) && newest=$e
  done
  shopt -u nullglob
  if (( n == 0 )); then
    report ok "briefs de projeto: nenhum (crie com maestro brief --write)"
  elif (( ${#bad[@]} > 0 )); then
    report warn "briefs de projeto: $(( n - ${#bad[@]} )) válido(s), ${#bad[@]} malformado(s)" \
      "$(join_semi "${bad[@]}") — regrave com maestro brief --write"
  else
    local age=$(( ( $(date +%s) - newest ) / 3600 ))
    report ok "briefs de projeto: $n válido(s) (mais novo: ${age}h)"
  fi
}

check_injection_bill() { # S-703: conta real da injeção vs teto de 8000B
  # Roda o hook de verdade (stdin sintético, estado em mktemp) e mede os bytes
  # que uma sessão receberia AGORA, com a config real deste repo. O RATCHET
  # (teto consciente, abaixo dos 8000B duros) vive no teste versionado
  # (tests/hooks/test-injection-budget.sh) — o doctor reporta o fato e avisa
  # acima de 90%; estourar os 8000B é falha de conteúdo.
  local hook="$REPO_DIR/hooks/session-start.sh"
  [[ -f "$hook" ]] || return 0
  local th tp bytes
  th=$(mktemp -d 2>/dev/null) || return 0
  tp=$(mktemp -d 2>/dev/null) || { rm -rf "$th"; return 0; }
  bytes=$(printf '{"session_id":"doctor-bill"}' \
    | MAESTRO_HOME="$th" CLAUDE_PROJECT_DIR="$tp" MAESTRO_OFF='' bash "$hook" 2>/dev/null \
    | wc -c | tr -d ' ') || bytes=''
  rm -rf "$th" "$tp"
  if [[ ! "$bytes" =~ ^[0-9]+$ ]] || (( bytes == 0 )); then
    report warn "injeção SessionStart: medição indisponível" "hook não emitiu (ambiente?)"
    return 0
  fi
  CAP_INJECTION_BYTES=$bytes
  if (( bytes > 8000 )); then
    report fail_val "injeção SessionStart dentro do teto de 8000B" "medido ${bytes}B (API_SPEC §1)"
  elif (( bytes > 7200 )); then
    report warn "injeção SessionStart: ${bytes}B de 8000B" "acima de 90% do teto — enxugue antes de adicionar seção"
  else
    report ok "injeção SessionStart: ${bytes}B de 8000B"
  fi
}

check_session_env() { # S-704: sinais do harness FORA do envelope do Maestro
  if [[ "${CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS:-}" == "1" ]]; then
    report warn "agent teams experimental ATIVO (CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1)" \
      "teams podem se formar sem pedido e o roteamento do Maestro não os governa"
  else
    report ok "agent teams experimental inativo"
  fi
  # MCP servers rodam além dos trilhos do Maestro (o gate não os intercepta) —
  # o doctor NOMEIA a superfície, nunca valores/config (só as chaves de nome).
  if ! has jq; then
    report skip "MCP fora-do-envelope" "requer jq"
    return 0
  fi
  local names='' f n
  for f in "$HOME/.claude.json" "${CLAUDE_PROJECT_DIR:-$PWD}/.mcp.json"; do
    [[ -f "$f" ]] || continue
    n=$(jq -r '(.mcpServers // {}) | keys | join(" ")' "$f" 2>/dev/null) || n=''
    [[ -n "$n" ]] && names+=" $n"
  done
  # shellcheck disable=SC2086
  names=$(printf '%s\n' $names | grep -v '^$' | sort -u | tr '\n' ' ' | sed 's/ $//') || names=''
  if [[ -n "$names" ]]; then
    report ok "MCP fora-do-envelope: $(wc -w <<<"$names" | tr -d ' ') server(s) — $names"
  else
    report ok "MCP fora-do-envelope: nenhum configurado"
  fi
}

write_capabilities() { # S-705 (P0.1 do ECC audit): envelope maestro.capabilities.v1
  # FATOS (não pass/fail) para consumidores FORA do doctor: o delegate() cita o
  # envelope quando decide/status quebram sem Bun; `maestro status` mostra a
  # idade. Gravado por último e SEMPRE — mesmo com falhas: o valor é justamente
  # diagnosticar depois. Só bool/int/string; sem jq → skip honesto, sem envelope.
  local checks=$N_CHECKS warns=$N_WARN skips=$N_SKIP fenv=$FAIL_ENV fval=$FAIL_VAL
  if ! has jq; then
    report skip "capabilities.json: envelope maestro.capabilities.v1" "requer jq"
    return 0
  fi
  mkdir -p "$MAESTRO_HOME" 2>/dev/null || {
    report warn "capabilities.json: envelope maestro.capabilities.v1" "sem onde gravar"; return 0; }
  local bunv='' gitv='' rn=0
  has bun && bunv=$(bun --version 2>/dev/null || true)
  if has git; then gitv=$(git --version 2>/dev/null | awk '{print $3}') || gitv=''; fi
  shopt -s nullglob; local ags=("$AGENTS_DIR"/*.md); rn=${#ags[@]}; shopt -u nullglob
  local tmp="$MAESTRO_HOME/capabilities.json.tmp.$$"
  if jq -n --arg at "$(date -Iseconds)" --argjson epoch "$(date +%s)" \
       --argjson bun "$(has bun && echo true || echo false)" --arg bunv "$bunv" \
       --argjson git "$(has git && echo true || echo false)" --arg gitv "$gitv" \
       --argjson flock "$(has flock && echo true || echo false)" \
       --argjson checks "$checks" --argjson warns "$warns" --argjson skips "$skips" \
       --argjson fail_env "$fenv" --argjson fail_val "$fval" \
       --argjson b_ok "$CAP_BINDINGS_OK" --argjson b_roots "$CAP_SKILL_ROOTS" \
       --argjson roster "$rn" --argjson inj "$CAP_INJECTION_BYTES" \
       --argjson ireg "$CAP_INSTALL_REGISTERED" --argjson idiv "$CAP_INSTALL_DIVERGENT" \
       --argjson ilive "$([[ $CAP_INSTALL_REPO_LIVE -eq 1 ]] && echo true || echo false)" \
       '{schema:"maestro.capabilities.v1", generated_at:$at, generated_epoch:$epoch,
         runtime:{bun:{present:$bun,version:$bunv}, jq:{present:true},
                  git:{present:$git,version:$gitv}, flock:{present:$flock}},
         doctor:{checks:$checks,warns:$warns,skips:$skips,fail_env:$fail_env,fail_val:$fail_val},
         bindings:{resolved:$b_ok, skill_roots:$b_roots},
         roster:{agents:$roster}, injection:{bytes:$inj, budget:8000},
         install:{registered:$ireg, divergent:$idiv, repo_is_live:$ilive}}' > "$tmp" 2>/dev/null \
     && mv -f "$tmp" "$MAESTRO_HOME/capabilities.json" 2>/dev/null; then
    report ok "capabilities.json: envelope maestro.capabilities.v1 gravado"
  else
    rm -f "$tmp" 2>/dev/null || true
    report warn "capabilities.json: envelope maestro.capabilities.v1" "falha ao gravar (não bloqueia nada)"
  fi
}

# ------------------------------------------------------------------ roster (E3)
#
# O roster é o gate MoE: a `description` do frontmatter é o texto por onde o
# Claude escolhe o agente, e o `name` é o identificador que o `maestro decide
# --agents` valida. Frontmatter quebrado não derruba nada em runtime — o hook e
# o CLI simplesmente ignoram o arquivo — e é exatamente por isso que o doctor
# precisa gritar: um agente invisível é indistinguível de um agente ausente.
# Tudo aqui é awk/bash puro: o doctor roda sem Bun e sem jq (modo degradado).

ROSTER_NAMES=''   # nomes válidos lidos do frontmatter, separados por espaço

# Campos separados por \037 (unit separator): tab colapsaria campos vazios no
# `read`, e é justamente o campo vazio que precisamos detectar.
roster_frontmatter() { # roster_frontmatter <arquivo> → name\037description\037model\037tools
  awk '
    function trim(s) { gsub(/\r/, "", s); gsub(/\t/, " ", s);
                       gsub(/^[ \t]+|[ \t]+$/, "", s); gsub(/^"|"$/, "", s); return s }
    NR == 1 && $0 !~ /^---[ \t\r]*$/ { exit }
    NR == 1                          { st = 1; next }
    st == 1 && /^---[ \t\r]*$/       { st = 2; exit }
    st == 1 && /^name:/              { nm = trim(substr($0, 6));  next }
    st == 1 && /^description:/       { ds = trim(substr($0, 13)); next }
    st == 1 && /^model:/             { md = trim(substr($0, 7));  next }
    st == 1 && /^tools:/             { tl = trim(substr($0, 7));  next }
    END { if (st == 2) printf "%s\037%s\037%s\037%s\n", nm, ds, md, tl }
  ' "$1" 2>/dev/null
}

join_semi() { local s; s=$(printf '%s; ' "$@"); printf '%s' "${s%; }"; }

check_roster() { # DATA_MODEL §5 (frontmatter obrigatório) + E3
  if [[ ! -d "$AGENTS_DIR" ]]; then
    report fail_env "roster: diretório agents/ presente" "$AGENTS_DIR não existe"
    return
  fi
  shopt -s nullglob
  local files=("$AGENTS_DIR"/*.md)
  shopt -u nullglob
  if [[ ${#files[@]} -eq 0 ]]; then
    report warn "roster: agents/*.md instalados" \
      "nenhum agente em $AGENTS_DIR — a injeção do SessionStart sai sem roster e --agents não é validado"
    return
  fi

  local f base line nm ds md tl problems=() dups=() seen=' '
  for f in "${files[@]}"; do
    base=$(basename -- "$f"); base="${base%.md}"
    if [[ ! -r "$f" ]]; then
      problems+=("$base.md: ilegível (fix: cheque permissões)")
      continue
    fi
    line=$(roster_frontmatter "$f")
    if [[ -z "$line" ]]; then
      problems+=("$base.md: frontmatter ausente ou não fechado por '---'")
      continue
    fi
    IFS=$'\037' read -r nm ds md tl <<<"$line"

    if [[ -z "$nm" ]]; then
      problems+=("$base.md: sem 'name:'")
    elif [[ ! "$nm" =~ ^[a-z0-9-]{1,40}$ ]]; then
      # mesma regex do session-start e do CLI: fora dela o agente é silenciosamente
      # ignorado pelos dois — instalado e invisível é o pior estado possível
      problems+=("$base.md: name '$nm' fora de kebab-case [a-z0-9-] — hook e CLI o ignoram")
    elif [[ "$nm" != "$base" ]]; then
      problems+=("$base.md: name '$nm' não casa com o nome do arquivo")
    fi
    if [[ -z "$ds" ]]; then
      problems+=("$base.md: 'description:' vazia — é o gate MoE, sem ela o agente nunca é escolhido")
    elif [[ "$ds" == '|'* || "$ds" == '>'* ]]; then
      problems+=("$base.md: 'description:' em bloco multi-linha (DATA_MODEL §5 exige 1 linha)")
    fi
    [[ "$md" =~ ^(haiku|sonnet|opus)$ ]] \
      || problems+=("$base.md: model '${md:-ausente}' fora de haiku|sonnet|opus")
    [[ -n "$tl" ]] || problems+=("$base.md: 'tools:' ausente ou vazio")

    if [[ -n "$nm" ]]; then
      [[ "$seen" == *" $nm "* ]] && dups+=("$nm")
      seen+="$nm "
      ROSTER_NAMES+="$nm "
    fi
  done

  if [[ ${#problems[@]} -gt 0 ]]; then
    report fail_val "roster: frontmatter dos agents/*.md (DATA_MODEL §5)" "$(join_semi "${problems[@]}")"
  else
    report ok "roster: ${#files[@]} agente(s) com frontmatter válido (name/description/model/tools)"
  fi
  if [[ ${#dups[@]} -gt 0 ]]; then
    report fail_val "roster: nomes sem colisão" \
      "duplicado(s): $(join_semi "${dups[@]}") (dois agentes com o mesmo name disputam o mesmo gate)"
  else
    report ok "roster: nomes sem colisão"
  fi
}

profile_experts() { # nomes declarados em `experts:` do .maestro.yaml (1 por linha)
  awk '/^experts:/ {
         v = $0; sub(/^experts:[ \t]*/, "", v); sub(/[ \t]*#.*$/, "", v)
         gsub(/[][",]/, " ", v); n = split(v, a, /[ \t]+/)
         for (i = 1; i <= n; i++) if (a[i] != "") print a[i]
         exit
       }' "$1" 2>/dev/null
}

check_project_profiles() { # S-303: expert inexistente no .maestro.yaml é aviso, nunca falha
  local dirs=("${CLAUDE_PROJECT_DIR:-$PWD}") d f e miss=() checked=0
  [[ "$REPO_DIR" != "${dirs[0]}" ]] && dirs+=("$REPO_DIR")
  for d in "${dirs[@]}"; do
    f="$d/.maestro.yaml"
    [[ -f "$f" && -r "$f" ]] || continue
    checked=$((checked + 1))
    while IFS= read -r e; do
      [[ "$e" =~ ^[a-z0-9-]+$ ]] || continue
      [[ " $ROSTER_NAMES " == *" $e "* ]] || miss+=("$(basename -- "$d")/.maestro.yaml → $e")
    done < <(profile_experts "$f")
  done

  if [[ $checked -eq 0 ]]; then
    report ok ".maestro.yaml de projeto: nenhum encontrado (valem os defaults globais)"
  elif [[ -z "${ROSTER_NAMES// /}" ]]; then
    report skip ".maestro.yaml: experts existem no roster" "roster vazio — nada com que comparar"
  elif [[ ${#miss[@]} -gt 0 ]]; then
    report warn ".maestro.yaml: experts existem no roster" \
      "fora do roster, ignorado(s) na injeção: $(join_semi "${miss[@]}")"
  else
    report ok ".maestro.yaml: experts existem no roster ($checked arquivo(s) verificado(s))"
  fi
}

check_release_diagram() { # S-1709: diagrama de arquitetura declarado vs. última tag — warn, nunca fail
  local proj="${CLAUDE_PROJECT_DIR:-$PWD}" f rev tag tagc
  f="$proj/docs/assets/architecture.json"
  if [[ ! -f "$f" ]]; then
    report skip "diagrama de release" "nenhum declarado (docs/assets/architecture.json)"
    return 0
  fi
  if ! has jq; then
    report skip "diagrama de release" "requer jq para ler docs/assets/architecture.json"
    return 0
  fi
  if ! has git; then
    report skip "diagrama de release" "requer git para comparar com a última tag"
    return 0
  fi
  tag=$(git -C "$proj" describe --tags --abbrev=0 2>/dev/null) || true
  if [[ -z "$tag" ]]; then
    report skip "diagrama de release" "repositório sem tag — nada com que comparar"
    return 0
  fi
  rev=$(jq -r '.meta.repository.revision // empty' "$f" 2>/dev/null) || true
  if [[ ! "$rev" =~ ^[0-9a-f]{40}$ ]]; then
    report warn "diagrama de release" "sem revision verificável em docs/assets/architecture.json"
    return 0
  fi
  tagc=$(git -C "$proj" rev-list -n1 "$tag" 2>/dev/null) || true
  if [[ -z "$tagc" ]]; then
    report skip "diagrama de release" "não consegui resolver o commit da tag $tag"
    return 0
  fi
  if [[ "$rev" == "$tagc" ]]; then
    report ok "diagrama de release: em dia com $tag"
  else
    report warn "diagrama de release" \
      "verificado em ${rev:0:7}, release $tag em ${tagc:0:7} — regenere com archify (--repo-root) e recommite"
  fi
}

# ------------------------------------------------------------------ decision records

now_epoch() { date +%s 2>/dev/null || printf '0\n'; }

record_mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || printf '0\n'
}

record_expired() { # 0 = expirado; fonte de verdade expires_at, fallback mtime (review P2-3)
  local f="$1" exp='' epoch now
  now=$(now_epoch)
  if has jq; then exp=$(jq -r '.expires_at // empty' "$f" 2>/dev/null || true); fi
  if [[ -n "$exp" ]] && epoch=$(date -d "$exp" +%s 2>/dev/null); then
    [[ $now -ge $epoch ]]
  else
    [[ $((now - $(record_mtime "$f"))) -ge $MAESTRO_TTL_SECONDS ]]
  fi
}

record_schema_ok() { # DATA_MODEL §3, sem campos extras
  local f="$1"
  jq -e --arg fields "$RECORD_FIELDS" '
    (type == "object")
    and (.session_id  | type == "string") and (.session_id | length > 0)
    and (.ts          | type == "string")
    and (.expires_at  | type == "string")
    and (.workflow    | type == "string")
    and (.mode as $m | ["direct","subagent","multi"] | index($m) != null)
    and ((keys - ($fields | split(" "))) | length == 0)
    and (((.reason // "") | length) <= 120)
    and (if has("agents") then (.agents | type == "array") else true end)
    and (if has("wtree") then (.wtree | type == "string" and test("^[0-9a-f]{40}$")) else true end)
    and (if has("outcome") then (.outcome as $o | ["accepted","rework","reverted"] | index($o) != null) else true end)
    and (if has("outcome_ts") then (.outcome_ts | type == "string") else true end)
    and (if has("suite") then (.suite as $s | ["pass","fail"] | index($s) != null) else true end)
    and (if (has("outcome_ts") or has("suite")) then has("outcome") else true end)
    and (if has("budget") then (.budget | type == "object"
      and ((keys - ["steps","minutes","cents"]) | length == 0)
      and (all(.[]; type == "number" and . == floor and . >= 1))) else true end)
    and (if has("suite_evidence") then (.suite_evidence as $e | ["cited","none"] | index($e) != null) else true end)
    and (if has("depth") then (.depth as $d | ["standard","deep","day-zero"] | index($d) != null) else true end)
    and (if has("profile") then (.profile as $p | ["prototipo","piloto","produto"] | index($p) != null) else true end)
    and (has("profile") == ((.depth // "") == "day-zero"))
    and (if has("brief") then (.brief | type == "string" and length <= 700
      and test("essencia:") and test("impacto:") and test("approach:")) else true end)
    and (if has("flags") then (.flags | type == "array"
      and all(.[]; type == "object"
        and ((keys - ["sev","decisao","tradeoff","mitigacao"]) | length == 0)
        and (all(.[]; type == "string" and length <= 120))
        and (if has("sev") then (.sev as $s | ["critical","high","medium","low"] | index($s) != null) else true end)))
      else true end)
  ' "$f" >/dev/null 2>&1
}

check_records() { # API_SPEC §1/§2 + DATA_MODEL §3: doctor valida schema e limpa TTL
  local dir="$MAESTRO_HOME/sessions"
  if [[ ! -d "$dir" ]]; then
    report ok "decision records: nenhum diretório de sessões ainda"
    return
  fi
  shopt -s nullglob
  local files=("$dir"/*.json)
  shopt -u nullglob
  if [[ ${#files[@]} -eq 0 ]]; then
    report ok "decision records: nenhum registrado"
    return
  fi
  if ! has jq; then
    report skip "decision records: schema DATA_MODEL §3" "requer jq (${#files[@]} record(s) não verificados)"
    return
  fi
  local kept=0 removed=0 bad=() pending=() f sid
  for f in "${files[@]}"; do
    if record_expired "$f"; then
      rm -f "$f" && removed=$((removed + 1))
      continue
    fi
    if record_schema_ok "$f"; then
      kept=$((kept + 1))
      # E17/S-1702: outcome fechado com o approach do brief ainda pendente é
      # sinal de regência incompleta — nunca falha o doctor, só avisa.
      if jq -e '(has("outcome")) and ((.brief // "") | contains("approach: pendente"))' \
           "$f" >/dev/null 2>&1; then
        pending+=("$(basename -- "$f")")
      fi
    else
      bad+=("$(basename -- "$f")")
    fi
  done
  if [[ ${#bad[@]} -gt 0 ]]; then
    report fail_val "decision records: schema DATA_MODEL §3" \
      "inválido(s): ${bad[*]} (fix: remova o(s) arquivo(s) em \$MAESTRO_HOME/sessions)"
  else
    report ok "decision records: $kept válido(s), $removed expirado(s) removido(s)"
  fi
  for f in "${pending[@]}"; do
    sid="${f%.json}"
    report warn "record $sid: outcome registrado com approach pendente (rode maestro conduct --approach)"
  done
}

# ----------------------------------------------------------------------- doctor

doctor() {
  local ci=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ci) ci=1 ;;
      -h|--help) usage; exit 0 ;;
      *) die validation "opção desconhecida '$1' em doctor" "maestro doctor [--ci]" 1 ;;
    esac
    shift
  done
  CI=$ci
  if [[ $CI -eq 0 && -t 1 && -z "${NO_COLOR:-}" ]]; then
    C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_FAIL=$'\033[31m'; C_OFF=$'\033[0m'
  fi

  # --- ambiente / fronteiras -------------------------------------------------
  if [[ -f "$REPO_DIR/hooks/lib/common.sh" ]]; then
    report ok "lib/common.sh presente"
    check env "kill-switch: MAESTRO_OFF respeitado por common.sh" \
      bash -c 'MAESTRO_OFF=1 bash -c "source \"$1\"; maestro_killswitch; exit 3"; [[ $? -eq 0 ]]' \
      _ "$REPO_DIR/hooks/lib/common.sh"
  else
    report fail_env "lib/common.sh presente" "$REPO_DIR/hooks/lib/common.sh não existe"
    report fail_env "kill-switch: MAESTRO_OFF respeitado por common.sh" "lib ausente"
  fi

  local h
  for h in session-start pre-tool-gate post-edit-habits user-prompt-submit; do
    if [[ ! -f "$REPO_DIR/hooks/$h.sh" ]]; then
      report fail_env "hook $h.sh presente e executável" "arquivo não existe"
    elif [[ ! -x "$REPO_DIR/hooks/$h.sh" ]]; then
      report fail_env "hook $h.sh presente e executável" "sem bit de execução (fix: chmod +x)"
    else
      report ok "hook $h.sh presente e executável"
    fi
  done

  # --- dependências (nunca confundidas com conteúdo inválido — review P2-7) --
  check env "dependência: jq instalado (API_SPEC §1)" command -v jq
  check env "dependência: flock disponível" command -v flock
  if has bun; then
    report ok "dependência: bun instalado ($(bun --version 2>/dev/null || echo '?'))"
  else
    report warn "dependência: bun ausente" "doctor roda em modo degradado; decide/status/log exigem Bun"
  fi

  # --- registro dos hooks e manifesto ---------------------------------------
  check_hooks_registry

  local pj="$REPO_DIR/.claude-plugin/plugin.json"
  if [[ ! -f "$pj" ]]; then
    report fail_env "plugin.json presente" "$pj não existe"
  else
    local rc=0; json_valid "$pj" || rc=$?
    if [[ $rc -eq 2 ]]; then
      report skip "plugin.json é JSON válido" "nem jq nem bun disponíveis para parsear"
    elif [[ $rc -ne 0 ]]; then
      report fail_val "plugin.json é JSON válido" "parse falhou"
    elif has jq && ! jq -e '(.name | type == "string") and (.version | type == "string")' \
                        "$pj" >/dev/null 2>&1; then
      report fail_val "plugin.json tem name e version" "campos obrigatórios ausentes"
    else
      report ok "plugin.json é JSON válido (name, version)"
    fi
  fi

  # --- config ----------------------------------------------------------------
  check_routing_table
  check_bindings
  check_binding_drift

  # --- roster (E3) -------------------------------------------------------------
  check_roster
  check_project_profiles
  check_release_diagram

  # --- estado ----------------------------------------------------------------
  if [[ "$MAESTRO_HOME" != "$MAESTRO_HOME_DEFAULT" ]]; then
    report warn "MAESTRO_HOME fora do default" \
      "usando '$MAESTRO_HOME' (default: '$MAESTRO_HOME_DEFAULT') — logs e records vão para lá"
  fi
  if mkdir -p "$MAESTRO_HOME/logs" "$MAESTRO_HOME/sessions" >/dev/null 2>&1 \
     && touch "$MAESTRO_HOME/logs/.w" >/dev/null 2>&1; then
    rm -f "$MAESTRO_HOME/logs/.w" 2>/dev/null || true
    report ok "diretório de estado gravável"
  else
    report fail_env "diretório de estado gravável" \
      "não consigo escrever em $MAESTRO_HOME (fix: cheque permissões ou exporte MAESTRO_HOME)"
  fi

  check_records
  check_briefs
  check_habit_guides
  check_commands
  check_consents
  check_evidence
  check_vendor_integrity
  check_plugin_install
  check_session_env
  check_injection_bill
  write_capabilities

  # --- veredito ---------------------------------------------------------------
  if [[ $FAIL_ENV -eq 1 ]]; then
    [[ $CI -eq 1 ]] && printf 'doctor: FALHOU — %s checagens, %s aviso(s), %s ignorada(s)\n' \
      "$N_CHECKS" "$N_WARN" "$N_SKIP"
    die env "doctor encontrou falhas de ambiente" "ver as linhas FAIL acima" 2
  fi
  if [[ $FAIL_VAL -eq 1 ]]; then
    [[ $CI -eq 1 ]] && printf 'doctor: FALHOU — %s checagens, %s aviso(s), %s ignorada(s)\n' \
      "$N_CHECKS" "$N_WARN" "$N_SKIP"
    die validation "doctor encontrou schema/registro inválido" "ver as linhas FAIL acima" 1
  fi
  if [[ $CI -eq 1 ]]; then
    printf 'doctor: ok — %s checagens, %s aviso(s), %s ignorada(s)\n' "$N_CHECKS" "$N_WARN" "$N_SKIP"
  else
    printf 'doctor: instalação saudável (%s checagens, %s aviso(s))\n' "$N_CHECKS" "$N_WARN"
  fi
  exit 0
}

# ------------------------------------------------------------------ docs (E16)

cmd_docs() { # S-1601/S-1602: docs canônicos como CONTRATO — drift mecânico
  # O doc declara `covers:` (globs) e opcionalmente `reviewed: <sha>` no
  # frontmatter YAML. Drift por FRONTEIRA COM QUITAÇÃO (pesquisa E16: "mesmo
  # commit" era falso positivo estrutural): STALE = commits que tocaram os
  # covers DESDE max(último commit no doc, reviewed) — qualquer toque no doc,
  # ou re-atestar via reviewed (provenance stamp, padrão Fiberplane Drift),
  # zera o contador sem edição cosmética. Contamos COMMITS, não dias: tempo
  # pune projeto parado; commits medem divergência real. Catraca versionada
  # (.maestro-docs.tsv): brownfield entra sem gritar, crescer trava (--check).
  local check=0 write_baseline=0 proj="${CLAUDE_PROJECT_DIR:-$PWD}"
  while (( $# )); do
    case "$1" in
      --check)    check=1 ;;
      --baseline) write_baseline=1 ;;
      --project)  proj="${2:-}"; shift ;;
      *) die validation "flag desconhecida '$1'" "maestro docs [--check|--baseline] [--project d]" 1 ;;
    esac
    shift
  done
  # shellcheck source=hooks/lib/common.sh
  source "$REPO_DIR/hooks/lib/common.sh"

  local yaml="$proj/.maestro.yaml" dlist=""
  if [[ -f "$yaml" ]]; then
    dlist=$(awk '/^docs:/ { sub(/^docs:[ \t]*/, ""); sub(/[ \t]*#.*$/, ""); print; exit }' "$yaml" 2>/dev/null | tr -d '[]" ' | tr ',' ' ')
  fi
  if [[ -z "${dlist// /}" ]]; then
    echo "docs canônicos: nenhum declarado (.maestro.yaml → docs: [a.md, b.md])"
    return 0
  fi
  git -C "$proj" rev-parse --git-dir >/dev/null 2>&1 \
    || die env "docs exige git (drift é medido em commits)" "" 2

  local total_repo
  total_repo=$(git -C "$proj" ls-files 2>/dev/null | grep -c . || true)
  local bfile="$proj/.maestro-docs.tsv"
  declare -A base=()
  if [[ -f "$bfile" ]]; then
    local _d _n
    while IFS=$'\t' read -r _d _n; do
      [[ "$_d" == \#* || -z "$_d" ]] && continue
      [[ "$_n" =~ ^[0-9]+$ ]] && base["$_d"]=$_n
    done < "$bfile"
  fi

  local d exceeded=() out_lines=() new_baseline="" total_stale=0
  for d in $dlist; do
    local df="$proj/$d"
    if [[ ! -f "$df" ]]; then
      out_lines+=("$d: AUSENTE — declarado no .maestro.yaml e não existe")
      exceeded+=("$d (ausente)")
      continue
    fi
    # frontmatter: covers (lista) + reviewed (sha) — só as primeiras 40 linhas
    local covers reviewed
    covers=$(awk 'NR==1 && $0 != "---" { exit } NR>40 { exit }
      /^---$/ { fm++; next } fm != 1 { next }
      /^covers:/ { inc=1; next }
      inc && /^[ \t]*-[ \t]*/ { s=$0; sub(/^[ \t]*-[ \t]*/, "", s); gsub(/["\x27 ]/, "", s); print s; next }
      inc { inc=0 }' "$df" 2>/dev/null | grep -E '^[A-Za-z0-9._*/-]+$' || true)
    reviewed=$(awk 'NR>40 { exit } /^---$/ { fm++; next } fm != 1 { next }
      /^reviewed:[ \t]*[0-9a-f]{7,40}[ \t]*$/ { sub(/^reviewed:[ \t]*/, ""); print; exit }' "$df" 2>/dev/null || true)
    if [[ -z "$covers" ]]; then
      out_lines+=("$d: sem covers: no frontmatter — doc canônico sem área governada é só prosa")
      continue
    fi
    # fronteira = mais NOVO entre último commit do doc e reviewed
    local b_doc b_rev="" boundary
    b_doc=$(git -C "$proj" log -1 --format=%H -- "$d" 2>/dev/null || true)
    if [[ -n "$reviewed" ]] && git -C "$proj" cat-file -e "$reviewed^{commit}" 2>/dev/null; then
      b_rev="$reviewed"
    fi
    boundary="$b_doc"
    if [[ -n "$b_rev" ]]; then
      if [[ -z "$boundary" ]] || git -C "$proj" merge-base --is-ancestor "$boundary" "$b_rev" 2>/dev/null; then
        boundary="$b_rev"
      fi
    fi
    # pathspecs dos covers + fan-out. set -f: sem ele, `src/**` expande contra
    # o CWD do bash antes de chegar ao git (mordeu no smoke — glob é do git).
    local spec=() g fan=0
    set -f
    for g in $covers; do spec+=(":(glob)$g"); done
    set +f
    fan=$(git -C "$proj" ls-files -- "${spec[@]}" 2>/dev/null | grep -c . || true)
    local fanwarn=""
    if [[ "$total_repo" -gt 20 && "$fan" -gt $(( total_repo / 2 )) ]]; then
      fanwarn=" · covers engole ${fan}/${total_repo} arquivos — glob largo demais vira ruído"
    fi
    local n=0
    if [[ -z "$boundary" ]]; then
      out_lines+=("$d: NÃO VERSIONADO (commite o doc para o drift existir)$fanwarn")
      new_baseline+="$d	0"$'\n'
      continue
    fi
    n=$(git -C "$proj" rev-list --count "$boundary..HEAD" -- "${spec[@]}" 2>/dev/null || echo 0)
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    total_stale=$(( total_stale + n ))
    if (( n == 0 )); then
      out_lines+=("$d: FRESCO (nenhum commit nos covers desde o doc/reviewed)$fanwarn")
    else
      out_lines+=("$d: STALE — $n commit(s) na área governada sem emenda (quite: emende, ou reviewed: $(git -C "$proj" rev-parse --short=7 HEAD))$fanwarn")
    fi
    new_baseline+="$d	$n"$'\n'
    local bl="${base[$d]:-0}"
    (( check == 1 )) && (( n > bl )) && exceeded+=("$d: $n > baseline $bl")
  done

  printf '%s\n' "${out_lines[@]}"

  if (( write_baseline == 1 )); then
    { printf '# maestro docs baseline (E16/S-1602) — catraca de drift: só desce.\n'
      printf '%s' "$new_baseline"
    } > "$bfile.tmp.$$" && mv -f "$bfile.tmp.$$" "$bfile" \
      || { rm -f "$bfile.tmp.$$"; die env "falha ao gravar $bfile" "" 2; }
    printf -- '---\nbaseline gravado: %s (%s doc(s))\n' "${bfile##*/}" "$(wc -w <<<"$dlist" | tr -d ' ')"
    return 0
  fi
  if (( check == 1 )); then
    if [[ ${#exceeded[@]} -gt 0 ]]; then
      printf -- '---\nCATRACA DE DOCS: drift novo acima do baseline — %s\n' "$(join_semi "${exceeded[@]}")"
      printf 'Emende o doc no mesmo changeset, ou re-ateste com reviewed: — a régua não sobe.\n'
      return 1
    fi
    printf -- '---\ndentro da catraca de docs\n'
  fi
  return 0
}

# ----------------------------------------------------------------- order (E15)

cmd_order() { # S-1501/S-1502: work order versionada com ESTADO DERIVADO
  # A ordem viaja com o repo (.maestro/orders/NNN.md — sobrevive a clone e
  # atravessa máquina via git) e carrega o contrato: objetivo, critérios,
  # frozen zones (BMAD), Ask-First, orçamento (E14) e o branch esperado.
  # O estado NUNCA é auto-declarado: deriva de git + evidence ledger + aceite —
  #   aberta       → nada aconteceu
  #   em_execucao  → o branch declarado existe
  #   provada      → recibo de evidência (label order-NNN) com exit 0 cujo
  #                  wtree_after == árvore do TIP do branch (prova mecânica de
  #                  que a suíte passou exatamente naquele conteúdo — S-701)
  #   aceita       → aceite explícito do diretor (--accept, auditado)
  # Executor não escreve o próprio boletim; o diretor assina o aceite.
  local action="" proj="${CLAUDE_PROJECT_DIR:-$PWD}" title="" branch="" frozen="" oid="" sid="" odoc=""
  local b_steps="" b_min="" b_cents=""
  while (( $# )); do
    case "$1" in
      --create)  action="create" ;;
      --list)    action="list" ;;
      --status)  action="status"; oid="${2:-}"; shift ;;
      --accept)  action="accept"; oid="${2:-}"; shift ;;
      --title)   title="${2:-}"; shift ;;
      --branch)  branch="${2:-}"; shift ;;
      --frozen)  frozen="${2:-}"; shift ;;
      --budget-steps) b_steps="${2:-}"; shift ;;
      --budget-min)   b_min="${2:-}"; shift ;;
      --budget-cents) b_cents="${2:-}"; shift ;;
      --doc)     odoc="${2:-}"; shift ;;
      --session) sid="${2:-}"; shift ;;
      --project) proj="${2:-}"; shift ;;
      *) die validation "flag desconhecida '$1'" \
           "maestro order --create --title t [--branch b] [--frozen \"a/ b/\"] | --list | --status N | --accept N" 1 ;;
    esac
    shift
  done
  [[ -n "$action" ]] || action="list"
  local odir="$proj/.maestro/orders"

  # shellcheck source=hooks/lib/common.sh
  source "$REPO_DIR/hooks/lib/common.sh"

  if [[ "$action" == "create" ]]; then
    [[ -n "$title" ]] || die validation "--title obrigatório" "o título é o contrato em uma linha" 1
    [[ -t 0 ]] && die validation "corpo ausente" \
      "passe objetivo/critérios/Ask-First via stdin (heredoc)" 1
    for v in "$b_steps" "$b_min" "$b_cents"; do
      [[ -z "$v" || "$v" =~ ^[0-9]{1,6}$ ]] || die validation "orçamento exige inteiros" "E14: passos/min/centavos" 1
    done
    local slug n next
    slug=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | tr -s '-' | head -c 32)
    slug="${slug%-}"; slug="${slug#-}"
    mkdir -p "$odir" 2>/dev/null || die env "não consigo criar $odir" "cheque permissões" 2
    next=1
    shopt -s nullglob
    for f in "$odir"/[0-9][0-9][0-9]-*.md "$odir"/[0-9][0-9][0-9].md; do
      n="${f##*/}"; n="${n%%[-.]*}"; n=$((10#$n))
      (( n >= next )) && next=$(( n + 1 ))
    done
    shopt -u nullglob
    oid=$(printf '%03d' "$next")
    [[ -n "$branch" ]] || branch="order/$oid-$slug"
    [[ "$branch" =~ ^[A-Za-z0-9/_-]{1,80}$ ]] || die validation "branch inválido" "" 1
    local of="$odir/$oid-$slug.md" head_sha
    head_sha=$(git -C "$proj" rev-parse HEAD 2>/dev/null) || head_sha="none"
    local body; body=$(head -c 16384)
    {
      printf '<!-- maestro-order v1\n'
      printf 'id: %s\nts: %s\nepoch: %s\nhead: %s\n' "$oid" "$(date -Iseconds)" "$(maestro_now_epoch)" "$head_sha"
      printf 'branch: %s\n' "$branch"
      [[ -n "$frozen" ]]  && printf 'frozen: %s\n' "$frozen"
      [[ -n "$b_steps" ]] && printf 'budget_steps: %s\n' "$b_steps"
      [[ -n "$b_min" ]]   && printf 'budget_min: %s\n' "$b_min"
      [[ -n "$b_cents" ]] && printf 'budget_cents: %s\n' "$b_cents"
      [[ -n "$odoc" ]] && printf 'doc: %s\n' "$odoc"
      printf 'author_session: %s\n' "${sid:-desconhecido}"
      printf -- '-->\n'
      printf '# Ordem %s — %s\n\n' "$oid" "$title"
      printf '%s\n' "$body"
      printf '\n## Contrato de execução\n'
      printf -- '- Trabalhe APENAS no branch `%s`; NUNCA no main/master.\n' "$branch"
      [[ -n "$frozen" ]] && printf -- '- Zonas CONGELADAS (não toque): %s\n' "$frozen"
      printf -- '- Prove com o ledger: `maestro evidence --record --label order-%s -- <suíte>` no tip do branch.\n' "$oid"
      [[ -n "$odoc" ]] && printf -- '- Esta ordem é autorizada por `%s` — siga-o; se a entrega mudar o contrato, EMENDE o doc no mesmo changeset (o aceite confere o frescor).\n' "$odoc"
      printf -- '- Estourou Ask-First ou orçamento? PARE e reporte ao humano — não improvise.\n'
      printf -- '- O aceite é do diretor: `maestro order --accept %s` (você não fecha a própria ordem).\n' "$oid"
    } > "$of.tmp.$$" && mv -f "$of.tmp.$$" "$of" \
      || { rm -f "$of.tmp.$$" 2>/dev/null; die env "falha ao gravar $of" "" 2; }
    log_event order_create ${sid:+session_id="$sid"} n="$((10#$oid))"
    printf 'ordem %s criada: %s\n  branch: %s\n  status: aberta (derivado — nada executado ainda)\n' "$oid" "$of" "$branch"
    return 0
  fi

  # helpers de derivação -----------------------------------------------------
  _order_field() { awk -F': ' -v k="$2" 'NR>14 { exit } $1 == k { print substr($0, length(k)+3); exit }' "$1" 2>/dev/null; }
  _order_status() { # <arquivo> → status derivado no stdout
    local f="$1" br ev_f ev_w tip_tree
    grep -q '^accepted_at: ' "$f" 2>/dev/null && { printf 'aceita'; return 0; }
    br=$(_order_field "$f" branch)
    if [[ -z "$br" ]] || ! git -C "$proj" rev-parse --verify --quiet "$br" >/dev/null 2>&1; then
      printf 'aberta'; return 0
    fi
    local o; o=$(_order_field "$f" id)
    ev_f=$(maestro_evidence_file "$proj" "order-$((10#$o))" 2>/dev/null)
    if [[ -f "$ev_f" ]] && grep -q '^exit=0$' "$ev_f" 2>/dev/null; then
      ev_w=$(awk -F= '/^wtree_after=/ { print $2; exit }' "$ev_f" 2>/dev/null)
      tip_tree=$(git -C "$proj" rev-parse --verify --quiet "$br^{tree}" 2>/dev/null)
      if [[ -n "$ev_w" && "$ev_w" == "$tip_tree" ]]; then
        printf 'provada'; return 0
      fi
    fi
    printf 'em_execucao'
    return 0
  }

  if [[ "$action" == "list" ]]; then
    [[ -d "$odir" ]] || { echo "nenhuma ordem em $odir (crie: maestro order --create)"; return 0; }
    local f any=0
    shopt -s nullglob
    for f in "$odir"/*.md; do
      any=1
      printf '%s  [%s]  %s\n' "$(_order_field "$f" id)" "$(_order_status "$f")" \
        "$(grep -m1 '^# ' "$f" | sed 's/^# //')"
    done
    shopt -u nullglob
    (( any == 0 )) && echo "nenhuma ordem em $odir"
    return 0
  fi

  [[ "$oid" =~ ^[0-9]{1,3}$ ]] || die validation "id de ordem inválido" "use o NNN do --list" 1
  oid=$(printf '%03d' "$((10#$oid))")
  local of
  # set -e + pipefail: ls de glob inexistente sai 2 e mataria a atribuição
  of=$(ls "$odir/$oid"-*.md "$odir/$oid.md" 2>/dev/null | head -1 || true)
  [[ -n "$of" && -f "$of" ]] || die validation "ordem $oid não existe" "maestro order --list" 1

  if [[ "$action" == "status" ]]; then
    local st br; st=$(_order_status "$of"); br=$(_order_field "$of" branch)
    printf 'ordem %s: %s\n' "$oid" "$st"
    printf '  arquivo : %s\n  branch  : %s' "$of" "${br:-?}"
    git -C "$proj" rev-parse --verify --quiet "$br" >/dev/null 2>&1 \
      && printf ' (existe, tip %s)\n' "$(git -C "$proj" rev-parse --short=7 "$br" 2>/dev/null)" \
      || printf ' (não existe)\n'
    printf '  prova   : ' 
    "$REPO_DIR/bin/maestro" evidence --label "order-$((10#$oid))" --project "$proj" 2>/dev/null | head -1 || echo "?"
    local _od; _od=$(_order_field "$of" doc)
    if [[ -n "$_od" ]]; then
      printf '  doc     : %s — ' "$_od"
      cmd_docs --project "$proj" 2>/dev/null | grep -m1 "^$_od:" | sed "s|^$_od: ||" || echo "?"
    fi
    case "$st" in
      provada) echo '  próximo : revisar e aceitar — maestro order --accept '"$oid" ;;
      aceita)  echo '  encerrada.' ;;
      *)       echo '  próximo : executor abre o branch, entrega e prova via ledger' ;;
    esac
    return 0
  fi

  if [[ "$action" == "accept" ]]; then
    local st; st=$(_order_status "$of")
    [[ "$st" == "aceita" ]] && { echo "ordem $oid já aceita"; return 0; }
    if [[ "$st" != "provada" ]]; then
      die validation "ordem $oid está '$st', não 'provada'" \
        "aceite exige prova mecânica no ledger (evidência verde no tip do branch)" 1
    fi
    printf 'accepted_at: %s\naccepted_session: %s\n' "$(date -Iseconds)" "${sid:-desconhecido}" >> "$of"
    log_event order_accept ${sid:+session_id="$sid"} n="$((10#$oid))"
    printf 'ordem %s ACEITA — merge/integração fica a seu critério (o aceite não mescla nada)\n' "$oid"
    return 0
  fi
}

# -------------------------------------------------------------- evidence (E13)

cmd_evidence() { # S-1301: recibo de execução amarrado a CONTEÚDO (padrão gstack-evidence)
  # "Testes passaram" deixa de ser prosa: o recibo grava wtree (S-701) ANTES e
  # DEPOIS da execução, hash do comando, exit e idade. A leitura só diz VÁLIDA
  # se o conteúdo de AGORA é byte-idêntico ao provado, o comando é o mesmo, a
  # idade cabe no teto e nada mexeu na árvore DURANTE a corrida. A IRON LAW
  # vira checagem mecânica, não sistema de honra. Bash puro; estado local
  # (classe do brief); nada disto toca o routing.jsonl.
  local mode="read" label="suite" check=0 proj="${CLAUDE_PROJECT_DIR:-$PWD}" maxage="${MAESTRO_EVIDENCE_MAX_AGE:-86400}"
  local cmd_args=()
  while (( $# )); do
    case "$1" in
      --record)  mode="record" ;;
      --check)   check=1 ;;
      --label)   label="${2:-}"; shift ;;
      --project) proj="${2:-}"; shift ;;
      --)        shift; cmd_args=("$@"); break ;;
      *) die validation "flag desconhecida '$1'" \
           "maestro evidence [--label l] [--check] | --record [--label l] -- <comando...>" 1 ;;
    esac
    shift
  done
  [[ "$label" =~ ^[a-z][a-z0-9-]{0,23}$ ]] || die validation "rótulo inválido" "minúsculas/dígitos/hífen, ≤24" 1
  [[ "$maxage" =~ ^[0-9]{1,8}$ ]] || maxage=86400

  # shellcheck source=hooks/lib/common.sh
  source "$REPO_DIR/hooks/lib/common.sh"
  local ef; ef=$(maestro_evidence_file "$proj" "$label")

  if [[ "$mode" == "record" ]]; then
    [[ ${#cmd_args[@]} -gt 0 ]] || die validation "comando ausente" \
      "maestro evidence --record -- bash tests/run-all.sh" 1
    local w_before="none" w_after="none" cmd_str cmd_hash rc=0
    [[ -x "$REPO_DIR/bin/maestro-wtree" ]] && \
      w_before=$("$REPO_DIR/bin/maestro-wtree" "$proj" 2>/dev/null) || w_before="none"
    cmd_str="${cmd_args[*]}"
    cmd_hash=$(printf '%s' "$cmd_str" | sha256sum 2>/dev/null | head -c 16) || cmd_hash="none"
    # set -e: exit != 0 é DADO (a falha é o que mais precisa de recibo), não
    # aborto — o || rc=$? blinda a captura.
    ( cd "$proj" && "${cmd_args[@]}" ) || rc=$?
    [[ -x "$REPO_DIR/bin/maestro-wtree" ]] && \
      w_after=$("$REPO_DIR/bin/maestro-wtree" "$proj" 2>/dev/null) || w_after="none"
    mkdir -p "${ef%/*}" 2>/dev/null || die env "não consigo criar ${ef%/*}" "cheque MAESTRO_HOME" 2
    local tmp="$ef.tmp.$$"
    {
      printf 'schema=maestro-evidence-v1\n'
      printf 'label=%s\nts=%s\nepoch=%s\n' "$label" "$(date -Iseconds)" "$(maestro_now_epoch)"
      printf 'cmd_hash=%s\nexit=%s\n' "$cmd_hash" "$rc"
      printf 'wtree_before=%s\nwtree_after=%s\n' "$w_before" "$w_after"
    } > "$tmp" 2>/dev/null && mv -f "$tmp" "$ef" 2>/dev/null \
      || { rm -f "$tmp" 2>/dev/null; die env "falha ao gravar recibo" "cheque permissões" 2; }
    if [[ "$w_before" != "$w_after" ]]; then
      printf 'evidência gravada: %s — exit %s, mas a árvore MUDOU durante a execução (recibo nasce contaminado)\n' "$label" "$rc"
    else
      printf 'evidência gravada: %s — exit %s, conteúdo %s\n' "$label" "$rc" "${w_after:0:12}"
    fi
    return "$rc"
  fi

  # --- leitura: o veredito ---------------------------------------------------
  if [[ ! -f "$ef" || ! -r "$ef" ]]; then
    echo "evidência ($label): NENHUMA — registre com: maestro evidence --record --label $label -- <comando>"
    (( check == 1 )) && return 1 || return 0
  fi
  local e_epoch="" e_exit="" e_wb="" e_wa="" e_hash=""
  eval "$(awk -F= 'NR>10 { exit }
    /^epoch=/        { if ($2 ~ /^[0-9]+$/)          print "e_epoch=" $2 }
    /^exit=/         { if ($2 ~ /^[0-9]+$/)          print "e_exit="  $2 }
    /^cmd_hash=/     { if ($2 ~ /^([0-9a-f]{16}|none)$/) print "e_hash=\047" $2 "\047" }
    /^wtree_before=/ { if ($2 ~ /^([0-9a-f]{40}|none)$/) print "e_wb=\047" $2 "\047" }
    /^wtree_after=/  { if ($2 ~ /^([0-9a-f]{40}|none)$/) print "e_wa=\047" $2 "\047" }' \
    "$ef" 2>/dev/null)" 2>/dev/null || :
  if [[ -z "$e_epoch" || -z "$e_wa" ]]; then
    echo "evidência ($label): recibo ilegível — regrave"
    (( check == 1 )) && return 1 || return 0
  fi
  local age=$(( $(maestro_now_epoch) - e_epoch )) reasons=""
  (( age < 0 )) && age=0
  [[ "$e_wb" != "$e_wa" ]] && reasons+="${reasons:+; }árvore mudou durante a corrida"
  (( age >= maxage )) && reasons+="${reasons:+; }idade no teto (${maxage}s)"
  local w_now="none"
  [[ -x "$REPO_DIR/bin/maestro-wtree" ]] && \
    w_now=$("$REPO_DIR/bin/maestro-wtree" "$proj" 2>/dev/null) || w_now="none"
  [[ "$w_now" == "none" || "$e_wa" == "none" ]] && reasons+="${reasons:+; }sem git para comparar conteúdo"
  [[ "$w_now" != "none" && "$e_wa" != "none" && "$w_now" != "$e_wa" ]] \
    && reasons+="${reasons:+; }conteúdo mudou desde a prova"
  [[ "$e_exit" != "0" ]] && reasons+="${reasons:+; }a execução provou FALHA (exit $e_exit)"
  if [[ -z "$reasons" ]]; then
    printf 'evidência (%s): VÁLIDA — exit 0 há %smin, conteúdo byte-idêntico ao provado\n' "$label" "$(( age / 60 ))"
    return 0
  fi
  printf 'evidência (%s): VENCIDA — %s. Re-rode e regrave.\n' "$label" "$reasons"
  (( check == 1 )) && return 1 || return 0
}

# ----------------------------------------------------------------- graph (E11)

cmd_graph() { # E11: freshness do grafo graphify — status para humanos e --check para rotina
  # O grafo é do graphify (skill externa, fora do envelope); o Maestro só mede
  # o frescor: mtime do graphify-out/graph.json vs último commit. Sem carimbo
  # próprio, sem dependência — grafo velho é fato morto vestido de mapa, e o
  # papel do Maestro é dizer isso em voz alta.
  # --check: exit 0 fresco/ausente · 1 STALE (a rotina de refresh usa isto).
  local check=0 proj="${CLAUDE_PROJECT_DIR:-$PWD}"
  while (( $# )); do
    case "$1" in
      --check) check=1 ;;
      --project) proj="${2:-}"; shift ;;
      *) die validation "flag desconhecida '$1'" "maestro graph [--check] [--project dir]" 1 ;;
    esac
    shift
  done
  # shellcheck source=hooks/lib/common.sh
  source "$REPO_DIR/hooks/lib/common.sh"
  local st word num
  st=$(maestro_graph_state "$proj")
  word="${st%% *}"; num="${st#* }"
  case "$word" in
    absent)
      echo "grafo: ausente (gere com /graphify . — opcional; vale em codebase grande)"
      return 0 ;;
    fresh)
      if (( num < 60 )); then num="${num}min"; else num="$(( num / 60 ))h"; fi
      echo "grafo: FRESCO (gerado há $num, nenhum commit depois) — graphify query responde estrutura"
      return 0 ;;
    stale)
      echo "grafo: STALE — $num commit(s) depois da geração. Atualize: /graphify . --update"
      (( check == 1 )) && return 1 || return 0 ;;
    nogit)
      echo "grafo: presente, projeto sem git — frescor não verificável"
      return 0 ;;
  esac
  return 0
}

# --------------------------------------------------------------- consent (E10)

cmd_consent() { # S-1005: consentimento escopado para a IA editar CONFIG protegida
  # Amendment do ADR-003 (v1.2): consentimento destrava DADOS (routing table,
  # roster), NUNCA a máquina (hooks/, bin/, src/, .claude-plugin/) — consentir
  # não pode equivaler a poder remover o gate. Escopado, com TTL curto,
  # auditado no log (consent_grant/consent_revoke com scope; nunca caminho).
  # O gate continua exigindo o resto do fluxo: consent só levanta a denylist.
  local action="" scope="" ttl=1800 sid=""
  while (( $# )); do
    case "$1" in
      --grant)  action="grant";  scope="${2:-}"; shift ;;
      --revoke) action="revoke"; scope="${2:-}"; shift ;;
      --ttl)
        case "${2:-}" in
          *m) ttl=$(( ${2%m} * 60 )) ;;
          *h) ttl=$(( ${2%h} * 3600 )) ;;
          *)  ttl="${2:-}" ;;
        esac; shift ;;
      --session) sid="${2:-}"; shift ;;
      *) die validation "flag desconhecida '$1'" \
           "maestro consent [--grant|--revoke <escopo>] [--ttl 30m] [--session id]" 1 ;;
    esac
    shift
  done
  [[ "$ttl" =~ ^[0-9]{1,6}$ ]] && (( ttl >= 60 && ttl <= 14400 )) \
    || die validation "TTL fora da janela (1min–4h)" "--ttl 30m é o default" 1
  [[ -z "$sid" || "$sid" =~ ^[A-Za-z0-9_-]{1,64}$ ]] \
    || die validation "session_id inválido" "use o id injetado pelo SessionStart" 1

  # shellcheck source=hooks/lib/common.sh
  source "$REPO_DIR/hooks/lib/common.sh"
  local cdir="$MAESTRO_HOME/consents" now
  now=$(maestro_now_epoch)

  if [[ -z "$action" ]]; then # listar
    local f sc exp rem any=0
    shopt -s nullglob
    for f in "$cdir"/*; do
      sc="${f##*/}"
      exp=$(awk -F= '/^expires=/ { print $2; exit }' "$f" 2>/dev/null)
      if [[ "$exp" =~ ^[0-9]+$ ]] && (( exp > now )); then
        rem=$(( (exp - now) / 60 ))
        printf 'ativo: %s (expira em %smin)\n' "$sc" "$rem"; any=1
      else
        rm -f "$f" 2>/dev/null || :
      fi
    done
    shopt -u nullglob
    (( any == 0 )) && echo "nenhum consentimento ativo (a denylist de autoproteção vale integral)"
    return 0
  fi

  case "$scope" in
    routing-table|roster|ops) ;;
    hooks|bin|src|cli|gate|plugin|.claude-plugin)
      die validation "escopo '$scope' NUNCA é consentível" \
        "consentimento destrava dados (routing-table, roster), não o mecanismo de enforcement (ADR-003 v1.2)" 1 ;;
    *) die validation "escopo desconhecido '$scope'" "escopos consentíveis: routing-table, roster, ops" 1 ;;
  esac

  if [[ "$action" == "revoke" ]]; then
    if [[ -f "$cdir/$scope" ]]; then
      rm -f "$cdir/$scope" 2>/dev/null || die env "não consegui remover $cdir/$scope" "cheque permissões" 2
      log_event consent_revoke ${sid:+session_id="$sid"} scope="$scope"
      printf 'consentimento revogado: %s\n' "$scope"
    else
      printf 'nada a revogar: %s não estava ativo\n' "$scope"
    fi
    return 0
  fi

  mkdir -p "$cdir" 2>/dev/null || die env "não consegui criar $cdir" "cheque MAESTRO_HOME" 2
  local tmp="$cdir/$scope.tmp.$$"
  {
    printf 'expires=%s\n' "$(( now + ttl ))"
    printf 'granted=%s\n' "$(date -Iseconds)"
    printf 'session=%s\n' "${sid:-desconhecido}"
  } > "$tmp" 2>/dev/null && mv -f "$tmp" "$cdir/$scope" 2>/dev/null \
    || { rm -f "$tmp" 2>/dev/null; die env "falha ao gravar consentimento" "cheque permissões" 2; }
  log_event consent_grant ${sid:+session_id="$sid"} scope="$scope"
  printf 'consentimento ATIVO: %s por %smin — a IA pode editar o escopo; o resto do gate segue valendo.\n' \
    "$scope" "$(( ttl / 60 ))"
  printf 'Revogue com: maestro consent --revoke %s (ou espere expirar)\n' "$scope"
  return 0
}

# --------------------------------------------------------------- outcome (E10)

cmd_outcome() { # S-1001: o desfecho — a variável dependente que faltava ao log
  # decide registra a APOSTA (workflow/mode/agents); outcome registra se ela
  # pagou: accepted | rework | reverted (+ suite pass|fail). Sem desfecho não
  # há aprendizado — é ele que o retro cruza com mode/agents para dizer qual
  # tier funciona. Enums no log, jamais texto.
  local sid="" verdict="" suite=""
  while (( $# )); do
    case "$1" in
      --session) sid="${2:-}"; shift ;;
      --suite)   suite="${2:-}"; shift ;;
      accepted|rework|reverted) verdict="$1" ;;
      *) die validation "argumento desconhecido '$1'" \
           "maestro outcome --session <id> <accepted|rework|reverted> [--suite pass|fail]" 1 ;;
    esac
    shift
  done
  [[ "$sid" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || die validation "session_id obrigatório" \
    "maestro outcome --session <id> <accepted|rework|reverted>" 1
  [[ -n "$verdict" ]] || die validation "desfecho obrigatório" "accepted | rework | reverted" 1
  [[ -z "$suite" || "$suite" =~ ^(pass|fail)$ ]] || die validation "--suite aceita pass|fail" "" 1
  has jq || die env "outcome exige jq" "instale jq (dependência declarada)" 2

  # shellcheck source=hooks/lib/common.sh
  source "$REPO_DIR/hooks/lib/common.sh"
  local rec="$MAESTRO_SESSIONS_DIR/$sid.json"
  [[ -f "$rec" ]] || die validation "não há decision record para a sessão $sid" \
    "o desfecho fecha uma decisão existente (maestro decide primeiro)" 1
  local tmp="$rec.tmp.$$"
  # E13/S-1302: --suite deixa de ser palavra de honra — consulta o ledger.
  local ev="none"
  if [[ -n "$suite" ]]; then
    if cmd_evidence --check --label suite --project "${CLAUDE_PROJECT_DIR:-$PWD}" >/dev/null 2>&1; then
      ev="cited"
    fi
  fi
  if jq --arg o "$verdict" --arg su "$suite" --arg evd "$ev" --arg ts "$(date -Iseconds)" \
       '.outcome = $o | .outcome_ts = $ts
        | (if $su != "" then .suite = $su | .suite_evidence = $evd else . end)' \
       "$rec" > "$tmp" 2>/dev/null && chmod 600 "$tmp" 2>/dev/null && mv -f "$tmp" "$rec" 2>/dev/null; then
    log_event outcome session_id="$sid" outcome="$verdict" ${suite:+suite="$suite"}
    printf 'desfecho registrado: %s%s (sessão %s)\n' "$verdict" "${suite:+ · suíte $suite}" "$sid"
    if [[ "$suite" == "pass" ]]; then
      if [[ "$ev" == "cited" ]]; then
        echo "suíte pass CITANDO evidência válida do ledger (mecânico, não honra)"
      else
        echo "aviso: suíte pass SEM evidência no ledger — palavra de honra; registre com: maestro evidence --record -- <suíte>"
      fi
    fi
  else
    rm -f "$tmp" 2>/dev/null
    die env "falha ao atualizar o record" "cheque permissões em $MAESTRO_SESSIONS_DIR" 2
  fi
  return 0
}

# --------------------------------------------------------------- conduct (E17)

cmd_conduct() { # S-1702: regência — mutação genérica do decision record
  # decide grava a APOSTA (workflow/mode/agents/depth/profile/brief); conduct
  # MUTA o record já existente, mesmo precedente de escrita de `outcome`:
  # (i) acumula flags[] tipadas (sev|decisao|tradeoff|mitigacao) consolidadas
  # pelo diretor a partir dos veredicts dos agentes; (ii) fecha o `approach:`
  # pendente do brief quando o plano nasce. Verbo genérico: cobre os dois
  # pontos de enforcement do item 4 do design com um único subcomando.
  local sid="" approach="" flags=()
  while (( $# )); do
    case "$1" in
      --session)  sid="${2:-}"; shift ;;
      --flag)     flags+=("${2:-}"); shift ;;
      --approach) approach="${2:-}"; shift ;;
      *) die validation "argumento desconhecido '$1'" \
           "maestro conduct --session <id> [--flag \"sev|decisao|tradeoff|mitigacao\"]... [--approach texto]" 1 ;;
    esac
    shift
  done
  [[ "$sid" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || die validation "session_id obrigatório" \
    "maestro conduct --session <id> [--flag ...] [--approach ...]" 1
  if [[ ${#flags[@]} -eq 0 && -z "$approach" ]]; then
    die validation "nada a registrar" "informe pelo menos um --flag ou --approach" 1
  fi
  [[ -z "$approach" || "${#approach}" -le 200 ]] || die validation "--approach excede 200 chars" "" 1
  has jq || die env "conduct exige jq" "instale jq (dependência declarada)" 2

  # shellcheck source=hooks/lib/common.sh
  source "$REPO_DIR/hooks/lib/common.sh"
  local rec="$MAESTRO_SESSIONS_DIR/$sid.json"
  [[ -f "$rec" ]] || die validation "não há decision record para a sessão $sid" \
    "conduct muta uma decisão existente (maestro decide primeiro)" 1

  # --flag "sev|decisao|tradeoff|mitigacao": exatamente 4 campos (3 '|'),
  # sev no enum fechado, cada campo <=120 chars, sem tab.
  local flag_objs=() f sev decisao tradeoff mitigacao pipes part
  for f in "${flags[@]}"; do
    [[ "$f" != *$'\t'* ]] || die validation "--flag não pode conter tab" "$f" 1
    pipes="${f//[^|]/}"
    [[ ${#pipes} -eq 3 ]] || die validation \
      "--flag exige exatamente 4 campos 'sev|decisao|tradeoff|mitigacao'" "$f" 1
    IFS='|' read -r sev decisao tradeoff mitigacao <<<"$f"
    [[ "$sev" =~ ^(critical|high|medium|low)$ ]] || die validation "sev fora do enum" \
      "critical|high|medium|low (recebido '$sev')" 1
    for part in "$sev" "$decisao" "$tradeoff" "$mitigacao"; do
      [[ "${#part}" -le 120 ]] || die validation "--flag com campo acima de 120 chars" "$f" 1
    done
    flag_objs+=("$(jq -nc --arg s "$sev" --arg d "$decisao" --arg t "$tradeoff" --arg m "$mitigacao" \
      '{sev:$s, decisao:$d, tradeoff:$t, mitigacao:$m}')")
  done
  local n_flags=${#flag_objs[@]}
  local new_flags_json='[]'
  if [[ $n_flags -gt 0 ]]; then
    new_flags_json=$(printf '%s\n' "${flag_objs[@]}" | jq -sc '.')
  fi

  local approach_flag="no"
  if [[ -n "$approach" ]]; then
    jq -e 'has("brief")' "$rec" >/dev/null 2>&1 || die validation "record sem brief" \
      "approach exige brief no record (maestro decide --brief \"essencia: ... impacto: ... approach: pendente\")" 1
    approach_flag="yes"
  fi

  local tmp="$rec.tmp.$$"
  if jq --argjson new_flags "$new_flags_json" --arg appr "$approach" --arg has_appr "$approach_flag" '
       (if ($new_flags | length) > 0 then .flags = ((.flags // []) + $new_flags) else . end)
       | (if $has_appr == "yes"
          then .brief = (.brief | sub("approach:.*$"; "approach: " + $appr))
          else . end)
     ' "$rec" > "$tmp" 2>/dev/null && chmod 600 "$tmp" 2>/dev/null && mv -f "$tmp" "$rec" 2>/dev/null; then
    log_event conduct session_id="$sid" flags_n="$n_flags" approach="$approach_flag"
    local appr_note=""
    if [[ "$approach_flag" == "yes" ]]; then appr_note=" · approach atualizado"; fi
    printf 'record %s mutado: %s flag(s)%s\n' "$sid" "$n_flags" "$appr_note"
  else
    rm -f "$tmp" 2>/dev/null
    die env "falha ao atualizar o record" "cheque permissões em $MAESTRO_SESSIONS_DIR" 2
  fi
  return 0
}

# ----------------------------------------------------------------- retro (E10)

cmd_retro() { # S-1002 + S-1004: o relatório que fecha o loop de aprendizado
  # Agregação DETERMINÍSTICA da janela (default 14 dias): o que aconteceu, em
  # números — override rate, gates, smells, desfecho por modo, workflows sem
  # uso. A INTERPRETAÇÃO é da IA nas bordas (/maestro:retro), que propõe diffs;
  # o exame é o eval-on-diff; o commit é o aprendizado versionado.
  local days=14
  while (( $# )); do
    case "$1" in
      --days) days="${2:-}"; shift ;;
      *) die validation "flag desconhecida '$1'" "maestro retro [--days N]" 1 ;;
    esac
    shift
  done
  [[ "$days" =~ ^[0-9]{1,3}$ ]] && (( days >= 1 )) || die validation "--days exige 1–999" "" 1
  has jq || die env "retro exige jq" "instale jq (dependência declarada)" 2

  # shellcheck source=hooks/lib/common.sh
  source "$REPO_DIR/hooks/lib/common.sh"
  local cutoff logs=() f
  cutoff=$(date -Iseconds -d "-$days days" 2>/dev/null) || cutoff=""
  shopt -s nullglob
  logs=("$MAESTRO_LOG_DIR"/routing.jsonl "$MAESTRO_LOG_DIR"/routing-*.jsonl)
  shopt -u nullglob
  local have=0; for f in "${logs[@]}"; do [[ -f "$f" ]] && have=1; done
  if (( have == 0 )); then
    printf 'retro: log vazio — sem dados na janela de %sd, sem conclusão a tirar.\n' "$days"
    return 0
  fi

  # S-1801 — o SENSOR (hooks/user-prompt-submit.sh, ADR-008) loga `override_manual`
  # para TODO prompt que começa com `/`; boa parte é ciclo de vida do plugin
  # (gstack-context-restore, login, cancel...), nunca teve rota automática pra
  # "override". O CONSUMIDOR separa: ROTEÁVEL = cmd bate com um alvo `skill:`
  # dos bindings (prefixo removido) OU com um nome de workflow — é só isso que
  # entra na taxa. `agent:`/`native:` não são slash command, ficam fora do
  # conjunto por definição. Tabela = fonte única (mesmo padrão de
  # profile_experts()); ausente/vazia degrada SEM quebrar o retro (S-1801 AC).
  local rt="${MAESTRO_ROUTING_TABLE:-$REPO_DIR/config/routing-table.yaml}"
  local routable="" routable_warn=""
  if [[ -f "$rt" && -r "$rt" ]]; then
    routable=$(awk '
      /^bindings:/ { in_b = 1; next }
      in_b && /^[a-zA-Z]/ { in_b = 0 }
      in_b {
        line = $0; sub(/#.*/, "", line)
        if (line ~ /^  [a-z_]+:/) {
          sub(/^  [a-z_]+:[ \t]*/, "", line)
          gsub(/[][]/, "", line)
          n = split(line, arr, /,[ \t]*/)
          for (i = 1; i <= n; i++) {
            tok = arr[i]; gsub(/^[ \t]+|[ \t]+$/, "", tok)
            if (tok ~ /^skill:/) { sub(/^skill:/, "", tok); print tok }
          }
        }
      }
      /^  [a-z]+:.*steps:/ { w = $0; gsub(/^  |:.*/, "", w); print w }
    ' "$rt" 2>/dev/null | awk '!s[$0]++') || routable=""
    [[ -z "$routable" ]] && routable_warn="routing-table sem bindings skill:/workflows reconhecíveis ($rt)"
  else
    routable_warn="routing-table.yaml ausente/ilegível ($rt)"
  fi
  local degrade=false
  [[ -n "$routable_warn" ]] && degrade=true
  local routable_json
  routable_json=$(printf '%s\n' "$routable" | jq -R -s 'split("\n") | map(select(length > 0))' 2>/dev/null) || routable_json='[]'
  [[ -z "$routable_json" ]] && routable_json='[]'

  printf '== maestro retro — janela de %s dia(s)%s\n' "$days" "${cutoff:+ (desde $cutoff)}"
  if [[ "$degrade" == true ]]; then
    printf -- '-- aviso: filtro roteável indisponível (%s) — override conta como no total (degradado, sem separar roteável/não-roteável)\n' "$routable_warn"
  fi
  jq -rs --arg cut "$cutoff" --argjson rtable "$routable_json" --argjson degrade "$degrade" '
    map(select(type == "object")) | map(select($cut == "" or .ts >= $cut)) as $w |
    ($w | map(select(.event == "decision"))) as $dec |
    ($w | map(select(.event == "override_manual"))) as $overs |
    ($overs | length) as $overs_n |
    ($overs | map(select(.cmd as $c | $c != null and ($rtable | index($c)) != null)) | length) as $mset_n |
    (if $degrade then $overs_n else $mset_n end) as $m |
    (if $degrade then 0 else ($overs_n - $mset_n) end) as $k |
    ($dec | length) as $ndec |
    (if $ndec > 0 then (100 * $m / $ndec | floor) else 0 end) as $rate |
    [
      "-- decisões: \($ndec) · override roteável: \($m) · não-roteável: \($k) · taxa de override: \($rate)%",
      "-- por modo: \($dec | group_by(.mode) | map("\(.[0].mode // "?"): \(length)") | join(" · "))",
      "-- por workflow: \($dec | group_by(.workflow) | map("\(.[0].workflow // "?"): \(length)") | join(" · "))",
      "-- gates: pass \($w | map(select(.event == "gate_pass")) | length) · warn \($w | map(select(.event == "gate_warn")) | length) · block \($w | map(select(.event == "gate_block")) | length)",
      "-- habit_warn: \($w | map(select(.event == "habit_warn")) | group_by(.smell) | sort_by(-length) | map("\(.[0].smell // "?"): \(length)") | join(" · ") | if . == "" then "nenhum" else . end)",
      "-- desfechos: \($w | map(select(.event == "outcome")) | group_by(.outcome) | map("\(.[0].outcome // "?"): \(length)") | join(" · ") | if . == "" then "NENHUM registrado — sem desfecho não há aprendizado (maestro outcome)" else . end)",
      "-- consentimentos: grant \($w | map(select(.event == "consent_grant")) | length) · revoke \($w | map(select(.event == "consent_revoke")) | length)"
    ] | .[]
  ' "${logs[@]}" 2>/dev/null || { echo "retro: log ilegível"; return 0; }

  # workflows declarados e nunca usados na janela (tabela = fonte; awk como no hook)
  local declared used unused=""
  declared=$(awk '/^  [a-z]+:.*steps:/ { gsub(/^  |:.*/, ""); print }' \
    "$REPO_DIR/config/routing-table.yaml" 2>/dev/null | awk '!s[$0]++')
  used=$(jq -rs --arg cut "$cutoff" \
    'map(select(type == "object" and .event == "decision" and ($cut == "" or .ts >= $cut))) | map(.workflow) | unique | .[]' \
    "${logs[@]}" 2>/dev/null || true)
  local wf
  while IFS= read -r wf; do
    [[ -n "$wf" ]] || continue
    grep -qx "$wf" <<<"$used" || unused+="${unused:+ }$wf"
  done <<<"$declared"
  [[ -n "$unused" ]] && printf -- '-- workflows declarados sem uso na janela: %s\n' "${unused// /, }"

  # S-1004 — critério de promoção warn→block, codificado (nunca automático)
  # S-1801: rate usa SÓ override roteável (mesma separação sensor/consumidor acima).
  local ndec m rate
  ndec=$(jq -rs --arg cut "$cutoff" 'map(select(type == "object" and .event == "decision" and ($cut == "" or .ts >= $cut))) | length' "${logs[@]}" 2>/dev/null || echo 0)
  if [[ "$degrade" == true ]]; then
    m=$(jq -rs --arg cut "$cutoff" 'map(select(type == "object" and .event == "override_manual" and ($cut == "" or .ts >= $cut))) | length' "${logs[@]}" 2>/dev/null || echo 0)
  else
    m=$(jq -rs --arg cut "$cutoff" --argjson rtable "$routable_json" \
      'map(select(type == "object" and .event == "override_manual" and ($cut == "" or .ts >= $cut) and (.cmd as $c | $c != null and ($rtable | index($c)) != null))) | length' \
      "${logs[@]}" 2>/dev/null || echo 0)
  fi
  rate=0; (( ndec > 0 )) && rate=$(( 100 * m / ndec ))
  # E14: orçamento — quantas decisões declararam caps e quantos estouros houve
  local n_bw
  n_bw=$(jq -rs --arg cut "$cutoff" 'map(select(type == "object" and .event == "budget_warn" and ($cut == "" or .ts >= $cut))) | length' "${logs[@]}" 2>/dev/null || echo 0)
  printf -- '-- orçamento: %s estouro(s) de cap na janela (budget_warn)\n' "$n_bw"
  # E13: cobertura do ledger de evidência (arquivos, não log — estado local)
  local n_ev=0 n_ev_ok=0 evf
  shopt -s nullglob
  for evf in "$MAESTRO_HOME/evidence"/*; do
    n_ev=$(( n_ev + 1 ))
    grep -q '^exit=0$' "$evf" 2>/dev/null && n_ev_ok=$(( n_ev_ok + 1 ))
  done
  shopt -u nullglob
  printf -- '-- evidência: %s recibo(s) no ledger, %s de exit 0\n' "$n_ev" "$n_ev_ok"
  printf -- '-- sinais:\n' 
  (( rate >= 20 )) && printf '   override em %s%% (≥20%%): a tabela está errando rota — calibrar ANTES de endurecer gate\n' "$rate"
  if (( days >= 14 && ndec >= 10 && rate < 20 )); then
    printf '   PROMOÇÃO ELEGÍVEL: %sd de janela, %s decisões, override %s%% (<20%%) — proponha gate.mode warn→block (diff na routing-table; exige consentimento ou mão humana)\n' \
      "$days" "$ndec" "$rate"
  else
    printf '   promoção warn→block: ainda não (exige ≥14d, ≥10 decisões, override <20%%)\n'
  fi
  return 0
}

# ---------------------------------------------------------------- habits (E9)

cmd_habits() { # S-903: os MESMOS sensores do hook, no momento do review/CI
  # O hook cutuca na edição; este comando varre o diff (ou caminhos dados) para
  # o step de review e para CI opcional. Sensor único (hooks/lib/
  # habit-sensors.awk), dois momentos — divergência entre eles seria dois
  # vocabulários de smell. Exit: 0 limpo · 1 achados · 2 ambiente.
  local scope="diff" paths=() proj="${CLAUDE_PROJECT_DIR:-$PWD}" write_baseline=0
  while (( $# )); do
    case "$1" in
      --all) scope="all" ;;
      --baseline) write_baseline=1; scope="all" ;;   # S-905: catraca grava do repo inteiro
      --project) proj="${2:-}"; shift ;;
      -*) die validation "flag desconhecida '$1'" "maestro habits [--all|--baseline] [caminhos...]" 1 ;;
      *) scope="paths"; paths+=("$1") ;;
    esac
    shift
  done
  local engine="$REPO_DIR/hooks/lib/habit-sensors.awk"
  local guides="${MAESTRO_HABIT_GUIDES:-$REPO_DIR/config/habit-guides}"
  [[ -f "$engine" ]] || die env "hooks/lib/habit-sensors.awk ausente" "reinstale o plugin (maestro doctor)" 2

  # sensores ativos: mesma resolução do hook (MAESTRO_HABITS > .maestro.yaml > all)
  local enabled="all" hline=""
  if [[ -n "${MAESTRO_HABITS+x}" ]]; then
    enabled="$MAESTRO_HABITS"
  elif [[ -f "$proj/.maestro.yaml" ]]; then
    hline=$(awk '/^habits:/ { sub(/^habits:[ \t]*/, ""); sub(/[ \t]*#.*$/, ""); print; exit }' \
      "$proj/.maestro.yaml" 2>/dev/null) || hline=""
    if [[ "$hline" =~ ^\[[[:space:]]*\]$ ]]; then enabled=""
    elif [[ "$hline" =~ ^\[.*\]$ ]]; then
      enabled=$(printf '%s' "$hline" | tr -d '[]" ' | tr ',' '\n' \
        | grep -E '^[a-z-]{1,24}$' | paste -sd, -) || enabled=""
    fi
  fi
  [[ -n "$enabled" ]] || { echo "habits: desligado neste projeto (habits: [])"; return 0; }

  local files=()
  if [[ "$scope" == "paths" ]]; then
    files=("${paths[@]}")
  elif [[ "$scope" == "all" ]]; then
    # rastreados + novos não-ignorados: slop novo chega em arquivo novo, e um
    # --all que não o vê é uma catraca com o dente quebrado.
    while IFS= read -r f; do [[ -n "$f" ]] && files+=("$proj/$f"); done < <(
      { git -C "$proj" ls-files 2>/dev/null
        git -C "$proj" ls-files --others --exclude-standard 2>/dev/null; } | sort -u)
    [[ ${#files[@]} -gt 0 ]] || die env "--all exige git" "passe caminhos explícitos" 2
  else
    while IFS= read -r f; do [[ -n "$f" ]] && files+=("$proj/$f"); done < <(
      { git -C "$proj" diff --name-only HEAD 2>/dev/null
        git -C "$proj" ls-files --others --exclude-standard 2>/dev/null; } | sort -u)
    if [[ ${#files[@]} -eq 0 ]]; then
      echo "habits: diff limpo (nada alterado desde HEAD; use --all ou caminhos)"
      return 0
    fi
  fi

  local total=0 shown ext base is_test out smells=''
  declare -A count=()
  for f in "${files[@]}"; do
    [[ -f "$f" && -r "$f" ]] || continue
    case "$f" in */vendor/*|*/node_modules/*|*/.git/*) continue ;; esac
    base="${f##*/}"; ext="${base##*.}"
    [[ "$ext" != "$base" ]] || continue
    case "$ext" in
      py|js|jsx|ts|tsx|go|rs|java|rb|php|c|h|cpp|hpp|cs|lua|sh|bash|zsh) ;;
      *) continue ;;
    esac
    is_test=0
    case "$base" in test*|*_test.*|*.test.*|*.spec.*|conftest.py) is_test=1 ;; esac
    case "$f" in */tests/*|*/test/*|*/__tests__/*) is_test=1 ;; esac
    out=$(awk -v EXT="$ext" -v ENABLED="$enabled" -v ISTEST="$is_test" \
      -f "$engine" "$f" 2>/dev/null | head -50) || out=""
    [[ -n "$out" ]] || continue
    shown="${f#"$proj"/}"
    while IFS=$'\t' read -r smell lineno detail; do
      [[ -n "$smell" ]] || continue
      total=$(( total + 1 ))
      count["$smell"]=$(( ${count["$smell"]:-0} + 1 ))
      printf '%s:%s: %s — %s\n' "$shown" "$lineno" "$smell" "$detail"
      case " $smells " in *" $smell "*) ;; *) smells+="${smells:+ }$smell" ;; esac
    done <<<"$out"
  done

  # ---- S-905: a catraca ----------------------------------------------------
  # Baseline = contagem POR SMELL, versionada no projeto (.maestro-habits.tsv).
  # Só desce por regravação deliberada (--baseline); subir exige editar o
  # arquivo — visível em review. Comparação SÓ no escopo --all (o baseline é do
  # repo inteiro; compará-lo com um diff seria mentir a régua). Padrão da casa:
  # mesmo desenho do ratchet da injeção (S-703) e do eval-on-diff (S-702).
  local bfile="$proj/.maestro-habits.tsv"
  if (( write_baseline == 1 )); then
    local btmp="$bfile.tmp.$$" sm
    {
      printf '# maestro habits baseline (S-905) — catraca anti-slop: só desce.\n'
      printf '# Regenerar (sempre para baixo, no mesmo commit do fix): maestro habits --baseline\n'
      for sm in $smells; do printf '%s\t%s\n' "$sm" "${count[$sm]}"; done | sort
    } > "$btmp" 2>/dev/null && mv -f "$btmp" "$bfile" 2>/dev/null \
      || { rm -f "$btmp" 2>/dev/null; die env "não consegui gravar $bfile" "cheque permissões" 2; }
    printf -- '---\nbaseline gravado: %s (%s achado(s) em %s smell(s))\n' \
      "${bfile##*/}" "$total" "$(printf '%s\n' $smells | grep -c . || true)"
    return 0
  fi

  if [[ "$scope" == "all" && -f "$bfile" && -r "$bfile" ]]; then
    local over=() sm bl cur improved=0
    declare -A base=()
    while IFS=$'\t' read -r sm bl; do
      [[ "$sm" =~ ^[a-z][a-z-]{2,23}$ && "$bl" =~ ^[0-9]+$ ]] && base["$sm"]=$bl
    done < "$bfile"
    for sm in "${!count[@]}"; do
      cur=${count[$sm]}; bl=${base[$sm]:-0}
      if (( cur > bl )); then over+=("$sm: $cur > baseline $bl")
      elif (( cur < bl )); then improved=1; fi
    done
    for sm in "${!base[@]}"; do
      [[ -n "${count[$sm]:-}" ]] || { (( base[$sm] > 0 )) && improved=1; }
    done
    if (( ${#over[@]} > 0 )); then
      printf -- '---\nCATRACA: slop novo acima do baseline — %s\n' "$(join_semi "${over[@]}")"
      printf 'Conserte o que entrou; a régua não sobe para acomodar o novo.\n'
      return 1
    fi
    printf -- '---\ndentro da catraca: %s achado(s), nenhum smell acima do baseline\n' "$total"
    (( improved == 1 )) && printf 'a régua pode descer: rode `maestro habits --baseline` no mesmo commit do fix\n'
    return 0
  fi

  if (( total == 0 )); then
    echo "habits: limpo (${#files[@]} arquivo(s) sensoriado(s))"
    return 0
  fi
  printf -- '---\n%s achado(s). Guias (sensor + guia, sempre juntos):\n' "$total"
  local g=0 gf
  for smell in $smells; do
    gf="$guides/$smell.md"
    [[ -f "$gf" ]] || continue
    g=$(( g + 1 )); (( g > 5 )) && { printf '… (guias restantes em %s/)\n' "$guides"; break; }
    printf '\n'; head -c 700 -- "$gf" 2>/dev/null || :; printf '\n'
  done
  return 1
}

# ----------------------------------------------------------------- brief (E8)

cmd_brief() { # S-801: brief de projeto — estado situacional carimbado por conteúdo
  # Bash puro de propósito: o brief é a arma contra o cold start e não pode
  # depender de Bun para existir. Carimbos: ts/epoch (idade), head (freshness
  # barata, comparada também pelo hook), wtree (S-701 — conteúdo, só no CLI:
  # ~200ms não cabe no NFR do hook), session (auditoria). O brief é ESTADO
  # local de trabalho (classe do gate-policy.sh) — nunca memória (ADR-007) e
  # nunca log: caminhos e narrativa jamais tocam o routing.jsonl.
  local mode="read" file="" sid="" proj="${CLAUDE_PROJECT_DIR:-$PWD}"
  while (( $# )); do
    case "$1" in
      --write)   mode="write" ;;
      --auto)    mode="auto" ;;
      --path)    mode="path" ;;
      --file)    file="${2:-}"; shift ;;
      --session) sid="${2:-}"; shift ;;
      --project) proj="${2:-}"; shift ;;
      *) die validation "flag desconhecida '$1'" \
           "maestro brief [--write|--auto|--path] [--file f] [--session id] [--project dir]" 1 ;;
    esac
    shift
  done
  [[ -z "$sid" || "$sid" =~ ^[A-Za-z0-9_-]{1,64}$ ]] \
    || die validation "session_id inválido" "use o id injetado pelo SessionStart" 1
  [[ -d "$proj" ]] || die validation "projeto '$proj' não é um diretório" "--project <dir>" 1

  # shellcheck source=hooks/lib/common.sh
  if [[ -f "$REPO_DIR/hooks/lib/common.sh" ]]; then
    source "$REPO_DIR/hooks/lib/common.sh"
  else
    die env "hooks/lib/common.sh não encontrado" "reinstale o plugin (maestro doctor)" 2
  fi
  local bf; bf=$(maestro_brief_file "$proj")

  if [[ "$mode" == "path" ]]; then printf '%s\n' "$bf"; return 0; fi

  if [[ "$mode" == "read" ]]; then
    if [[ ! -f "$bf" ]]; then
      printf 'nenhum brief para este projeto (crie: maestro brief --write, narrativa via stdin; --auto gera o esqueleto)\n'
      return 0
    fi
    brief_verdict "$bf" "$proj"
    printf -- '---\n'
    # pula o cabeçalho de carimbos; o leitor quer a narrativa
    awk 'skip==1 { print; next } /^-->$/ { skip=1 }' "$bf"
    return 0
  fi

  # --- write | auto ----------------------------------------------------------
  local narrative=""
  if [[ "$mode" == "auto" ]]; then
    narrative=$(brief_auto_skeleton "$proj")
  elif [[ -n "$file" ]]; then
    [[ -f "$file" && -r "$file" ]] || die validation "arquivo '$file' ilegível" "--file <narrativa.md>" 1
    narrative=$(head -c 16384 -- "$file")
  else
    [[ -t 0 ]] && die validation "narrativa ausente" \
      "passe a narrativa via stdin (heredoc), --file, ou use --auto" 1
    narrative=$(head -c 16384)
  fi
  [[ -n "${narrative//[[:space:]]/}" ]] || die validation "narrativa vazia" \
    "o brief sem conteúdo não poupa varredura nenhuma" 1

  local head_sha="none" wtree="none" ts epoch
  head_sha=$(git -C "$proj" rev-parse HEAD 2>/dev/null) || head_sha="none"
  if [[ -x "$REPO_DIR/bin/maestro-wtree" ]]; then
    wtree=$("$REPO_DIR/bin/maestro-wtree" "$proj" 2>/dev/null) || wtree="none"
  fi
  [[ "$wtree" =~ ^[0-9a-f]{40}$ ]] || wtree="none"
  ts=$(date -Iseconds); epoch=$(date +%s)

  mkdir -p "${bf%/*}" 2>/dev/null \
    || die env "não consigo criar ${bf%/*}" "cheque permissões ou MAESTRO_HOME" 2
  local tmp="$bf.tmp.$$"
  {
    printf '<!-- maestro-brief v1\n'
    printf 'ts: %s\nepoch: %s\nhead: %s\nwtree: %s\nsession: %s\n' \
      "$ts" "$epoch" "$head_sha" "$wtree" "${sid:-desconhecido}"
    printf -- '-->\n'
    printf '%s\n' "$narrative"
  } > "$tmp" 2>/dev/null && mv -f "$tmp" "$bf" 2>/dev/null \
    || { rm -f "$tmp" 2>/dev/null; die env "falha ao gravar $bf" "cheque permissões" 2; }
  printf 'brief gravado: %s (%sB' "$bf" "$(wc -c < "$bf" | tr -d ' ')"
  [[ "$head_sha" != "none" ]] && printf ', HEAD %s' "${head_sha:0:7}"
  printf ')\n'
  return 0
}

brief_verdict() { # <brief> <proj> → uma linha de freshness no stdout
  local bf="$1" proj="$2" b_epoch="" b_head="" b_wtree=""
  # só as primeiras 8 linhas: o cabeçalho é fixo e a narrativa não é confiável
  eval "$(awk 'NR>8 || /^-->$/ { exit }
    /^epoch: /  { v=substr($0,8);  if (v ~ /^[0-9]+$/)      print "b_epoch=" v }
    /^head: /   { v=substr($0,7);  if (v ~ /^([0-9a-f]{40}|none)$/) print "b_head=\047" v "\047" }
    /^wtree: /  { v=substr($0,8);  if (v ~ /^([0-9a-f]{40}|none)$/) print "b_wtree=\047" v "\047" }' "$bf" 2>/dev/null)" 2>/dev/null || :

  local age="idade desconhecida"
  if [[ "$b_epoch" =~ ^[0-9]+$ ]]; then
    local d=$(( $(date +%s) - b_epoch ))
    if   (( d < 0 ));     then age="carimbo no futuro"
    elif (( d < 3600 ));  then age="há $(( d / 60 ))min"
    elif (( d < 86400 )); then age="há $(( d / 3600 ))h"
    else                       age="há $(( d / 86400 ))d"; fi
  fi

  local cur_head; cur_head=$(git -C "$proj" rev-parse HEAD 2>/dev/null) || cur_head=""
  if [[ -z "$b_epoch$b_head" ]]; then
    printf 'brief: carimbo ilegível (regrave: maestro brief --write) — %s\n' "$bf"
  elif [[ -z "$cur_head" || "$b_head" == "none" ]]; then
    printf 'brief: escrito %s (fora de git — sem veredito de conteúdo) — %s\n' "$age" "$bf"
  elif [[ "$b_head" == "$cur_head" ]]; then
    local same=""
    if [[ "$b_wtree" != "none" && -x "$REPO_DIR/bin/maestro-wtree" ]]; then
      local cw; cw=$("$REPO_DIR/bin/maestro-wtree" "$proj" 2>/dev/null) || cw=""
      if [[ "$cw" == "$b_wtree" ]]; then same=", working tree idêntico"
      elif [[ -n "$cw" ]]; then same=", working tree MUDOU desde o carimbo"; fi
    fi
    printf 'brief: FRESCO — HEAD %s inalterado, escrito %s%s\n' "${cur_head:0:7}" "$age" "$same"
  else
    local n; n=$(git -C "$proj" rev-list --count "$b_head..$cur_head" 2>/dev/null) || n=""
    if [[ "$n" =~ ^[0-9]+$ ]]; then
      printf 'brief: STALE — %s commit(s) desde o carimbo (%s → %s), escrito %s. Confie no git, não nele.\n' \
        "$n" "${b_head:0:7}" "${cur_head:0:7}" "$age"
    else
      printf 'brief: STALE — HEAD mudou desde o carimbo (%s → %s; histórico reescrito?), escrito %s\n' \
        "${b_head:0:7}" "${cur_head:0:7}" "$age"
    fi
  fi
  return 0
}

brief_auto_skeleton() { # <proj> → esqueleto determinístico no stdout (sem LLM)
  local proj="$1"
  printf '# Brief — %s (esqueleto --auto; substitua pela narrativa real)\n\n' "${proj##*/}"
  if git -C "$proj" rev-parse --git-dir >/dev/null 2>&1; then
    printf '## Últimos commits\n'
    git -C "$proj" log --oneline -5 2>/dev/null | sed 's/^/- /' || :
    local dirty; dirty=$(git -C "$proj" status --porcelain 2>/dev/null | grep -c . || true)
    printf '\n## Working tree\n- %s arquivo(s) sujo(s)\n' "${dirty:-0}"
    local branch; branch=$(git -C "$proj" branch --show-current 2>/dev/null) || branch=""
    [[ -n "$branch" ]] && printf -- '- branch: %s\n' "$branch"
  else
    printf -- '- fora de git: sem histórico para resumir\n'
  fi
  local n_rec=0 recs
  shopt -s nullglob
  recs=("$MAESTRO_HOME/sessions"/*.json); n_rec=${#recs[@]}
  shopt -u nullglob
  printf '\n## Maestro\n- %s decision record(s) no estado local\n' "$n_rec"
  printf '\n## Em curso / próximo passo\n- (a sessão que fecha o trabalho escreve isto)\n'
  return 0
}

# ----------------------------------------------------------------------- dispatch

delegate() { # decide|status|log → src/cli.ts (CONTRATO §4)
  local sub="$1"; shift
  if ! has bun; then
    # E7/S-705: em vez de erro seco, cita o último envelope de capacidades —
    # o doctor sabia; o erro agora conta o que ele sabia e quando.
    local hint='' cap="$MAESTRO_HOME/capabilities.json" at='' epoch=0 age=0
    if [[ -f "$cap" ]] && has jq; then
      at=$(jq -r '.generated_at // empty' "$cap" 2>/dev/null || true)
      epoch=$(jq -r '.generated_epoch // 0' "$cap" 2>/dev/null || echo 0)
      if [[ -n "$at" && "$epoch" =~ ^[0-9]+$ && "$epoch" -gt 0 ]]; then
        age=$(( ($(date +%s) - epoch) / 3600 ))
        hint=" — último doctor: $at (${age}h atrás)"
        [[ $age -ge 24 ]] && hint="$hint; envelope velho"
      fi
    fi
    die env "'$sub' exige Bun e o binário não está no PATH$hint" \
      "instale o Bun (https://bun.sh) — 'maestro doctor' segue funcionando sem ele" 2
  fi
  [[ -f "$REPO_DIR/src/cli.ts" ]] || die env "src/cli.ts não encontrado em $REPO_DIR" \
    "reinstale o plugin (maestro doctor)" 2
  exec bun "$REPO_DIR/src/cli.ts" "$sub" "$@"
}

cmd="${1:-}"
case "$cmd" in
  doctor) shift; doctor "$@" ;;
  decide|status|log) shift; delegate "$cmd" "$@" ;;
  brief) shift; cmd_brief "$@" ;;
  habits) shift; cmd_habits "$@" ;;
  consent) shift; cmd_consent "$@" ;;
  outcome) shift; cmd_outcome "$@" ;;
  conduct) shift; cmd_conduct "$@" ;;
  retro) shift; cmd_retro "$@" ;;
  graph) shift; cmd_graph "$@" ;;
  evidence) shift; cmd_evidence "$@" ;;
  order) shift; cmd_order "$@" ;;
  docs) shift; cmd_docs "$@" ;;
  ""|-h|--help) usage ;;
  *) die validation "comando desconhecido '$cmd'" "maestro --help" 1 ;;
esac
