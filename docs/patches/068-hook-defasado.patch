index 0000000..1f5179c
--- /dev/null
+++ b/hooks/lib/version.sh
@@ -0,0 +1,70 @@
+#!/usr/bin/env bash
+# maestro hooks/lib/version.sh — ordem 068: o veredito de versão do plugin EM USO contra o repo.
+#
+# UMA função, UM veredito: `maestro plugin-version`, o `maestro doctor`, o `session-start` e o
+# `user-prompt-submit` chamam `maestro_version_verdict`; nenhum faz a própria comparação.
+#
+#   maestro_version_verdict <raiz em uso> <raiz do repo>
+#     define MV_VERDICT  ok | atras | indeterminado
+#            MV_REASON   razão legível ("cache 1.21.0 < repo 1.22.0"; só versões, nunca caminho)
+#            MV_USO / MV_REPO  as versões lidas (vazias quando não lidas)
+#     retorna 0 (ok) · 1 (atrás) · 2 (indeterminado)
+#
+# Semver por INTEIROS (major.minor.patch, base 10 forçada — "09" não é octal). Só é `atras` quando as
+# DUAS versões foram lidas e a em uso é MENOR; em uso maior ou igual é `ok`. Qualquer falha de leitura
+# (raiz vazia, plugin.json ausente ou ilegível, versão fora de major.minor.patch) é `indeterminado`,
+# NUNCA `atras` (CLAUDE.md: falha de componente não bloqueia).
+#
+# Bash puro, sem fork: o plugin.json (arquivo pequeno) é lido linha a linha por `read` + regex.
+
+_mv_read() { # <raiz> → MV_READ="maj min pat" · rc 0 lido, 1 não lido
+  MV_READ=""
+  local f="$1/.claude-plugin/plugin.json" line
+  [[ -n "$1" && -r "$f" ]] || return 1
+  while IFS= read -r line || [[ -n "$line" ]]; do
+    if [[ "$line" =~ ^[[:space:]]*\"version\"[[:space:]]*:[[:space:]]*\"([0-9]{1,9})\.([0-9]{1,9})\.([0-9]{1,9})\"[[:space:]]*,?[[:space:]]*$ ]]; then
+      MV_READ="${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]}"
+      return 0
+    fi
+  done < "$f"
+  return 1
+}
+
+maestro_version_verdict() { # <raiz em uso> <raiz do repo>
+  MV_VERDICT="indeterminado"; MV_REASON=""; MV_USO=""; MV_REPO=""
+  local uso_t repo_t
+  if [[ -z "${1:-}" ]]; then MV_REASON="raiz em uso indefinida"; return 2; fi
+  if ! _mv_read "$1"; then MV_REASON="versão em uso ilegível"; return 2; fi
+  uso_t="$MV_READ"
+  if [[ -z "${2:-}" ]] || ! _mv_read "$2"; then MV_REASON="versão do repo ilegível"; return 2; fi
+  repo_t="$MV_READ"
+  local -a u r; read -r -a u <<< "$uso_t"; read -r -a r <<< "$repo_t"
+  MV_USO="${u[0]}.${u[1]}.${u[2]}"; MV_REPO="${r[0]}.${r[1]}.${r[2]}"
+  local i a b
+  for i in 0 1 2; do
+    a=$((10#${u[i]})); b=$((10#${r[i]}))
+    if (( a < b )); then
+      MV_VERDICT="atras"; MV_REASON="cache $MV_USO < repo $MV_REPO"; return 1
+    elif (( a > b )); then
+      break
+    fi
+  done
+  MV_VERDICT="ok"; MV_REASON="cache $MV_USO >= repo $MV_REPO"
+  return 0
+}
+
+# maestro_repo_root → imprime a raiz do repo do Maestro para quem roda DENTRO do plugin (hooks), que
+# não tem um REPO_DIR próprio: MAESTRO_REPO_DIR (override) ou o `installLocation` do marketplace de
+# diretório do Maestro em known_marketplaces.json (o checkout canônico que o Capitão gira).
+# Vazio = não achou (veredito indeterminado). Só roda no caminho raro (turno de ordem headless,
+# session-start), nunca no caminho comum de um prompt.
+maestro_repo_root() {
+  if [[ -n "${MAESTRO_REPO_DIR:-}" ]]; then printf '%s' "$MAESTRO_REPO_DIR"; return 0; fi
+  local mk="${MAESTRO_PLUGINS_DIR:-$HOME/.claude/plugins}/known_marketplaces.json" loc=""
+  [[ -r "$mk" ]] && command -v jq >/dev/null 2>&1 || return 0
+  loc=$(jq -r '(to_entries // [])[]
+      | select((.key == "maestro") and ((.value.source.source // "") == "directory"))
+      | .value.installLocation // empty' "$mk" 2>/dev/null | head -1) || loc=""
+  [[ -n "$loc" && -d "$loc" ]] && printf '%s' "$loc"
+  return 0
+}
