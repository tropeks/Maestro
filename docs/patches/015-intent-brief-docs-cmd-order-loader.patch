 # ------------------------------------------------------------- ação: --create
 _order_slug() { # <título> → slug de arquivo/branch (minúsculo, [a-z0-9-], até 32)
@@ -29,6 +34,7 @@ _order_create_write() { # <proj> <oid> <título> <branch> <frozen> <extra> <doc>
   local of="$proj/.maestro/orders/$oid-$(_order_slug "$title").md" head_sha
