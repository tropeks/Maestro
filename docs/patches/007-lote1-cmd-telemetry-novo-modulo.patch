diff --git a/lib/cmd-telemetry.sh b/lib/cmd-telemetry.sh
new file mode 100644
index 0000000..9303aa3
--- /dev/null
+++ b/lib/cmd-telemetry.sh
@@ -0,0 +1,162 @@
+#!/usr/bin/env bash
+# maestro lib/cmd-telemetry.sh — E20/S-2001, extraído de bin/maestro no E24 Lote 1
+#
+# `maestro telemetry` é a metade CLI de hooks/lib/telemetry-sync.sh (S-2001):
+# git como barramento — cada máquina publica SEUS logs/<host-id>/ num remoto
+# opt-in (telemetry_remote no config.yaml). Nada sai sem essa chave.
+#
+# Sourced por bin/maestro (via _telemetry_lib_load, I-2) DENTRO do mesmo
+# processo — REPO_DIR, MAESTRO_HOME e die() já estão no escopo; nenhum fork,
+# nenhuma duplicação. Duas responsabilidades vivem aqui, separadas por seção:
+# escrita crua de config.yaml (_tel_cli_config_*) e as ações do comando
+# (_telemetry_*).
+
+# ------------------------------------------------------------ config.yaml (I/O)
+#
+# Isolado das ações porque é a única parte que toca disco fora do clone de
+# telemetria — mesma técnica (tmp + mv, sem editar em lugar) usada pelo resto
+# do CLI para config.yaml.
+
+_tel_cli_config_set_remote() { # <url> — grava/substitui telemetry_remote, resto do config.yaml intacto
+  # NÃO reaproveita maestro_update_config_set: ela só aceita valor em
+  # [A-Za-z0-9_.-]{1,32} (chaves internas), e uma URL de git é mais larga e
+  # mais longa que isso. Mesma técnica (tmp + mv, sem editar em lugar).
+  local url="$1" f="$MAESTRO_HOME/config.yaml" tmp
+  mkdir -p "$MAESTRO_HOME" 2>/dev/null || return 1
+  tmp="$f.tmp.$$"
+  {
+    if [[ -f "$f" ]]; then
+      grep -v -E '^telemetry_remote:' "$f" 2>/dev/null || :
+    else
+      printf '# maestro — config por máquina (DATA_MODEL §10)\n'
+    fi
+    printf 'telemetry_remote: %s\n' "$url"
+  } > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
+  mv -f "$tmp" "$f" 2>/dev/null || { rm -f "$tmp"; return 1; }
+  return 0
+}
+
+_tel_cli_config_remove_remote() { # remove a linha telemetry_remote (config sem a chave = desligada)
+  local f="$MAESTRO_HOME/config.yaml" tmp
+  [[ -f "$f" ]] || return 0
+  tmp="$f.tmp.$$"
+  grep -v -E '^telemetry_remote:' "$f" > "$tmp" 2>/dev/null || :
+  mv -f "$tmp" "$f" 2>/dev/null || { rm -f "$tmp"; return 1; }
+  return 0
+}
+
+# ------------------------------------------------------------------ ações do CLI
+
+_telemetry_status() { # --status (default): estado legível a partir de telemetry-state
+  if ! maestro_telemetry_enabled; then
+    printf 'telemetria: desligada (sem telemetry_remote — maestro telemetry --remote <url>)\n'
+    return 0
+  fi
+  local result; result=$(_tel_state_read result)
+  if [[ -z "$result" ]]; then
+    printf 'telemetria: configurada, nunca publicou (a próxima sessão publica; --push força)\n'
+    return 0
+  fi
+  local host files reason pushed now hago
+  host=$(_tel_state_read host); files=$(_tel_state_read files); reason=$(_tel_state_read reason)
+  pushed=$(_tel_state_read pushed); [[ "$pushed" =~ ^[0-9]+$ ]] || pushed=0
+  now=$(_tel_now); hago=$(( (now - pushed) / 3600 ))
+  case "$result" in
+    pushed)   printf 'telemetria: publicada há %sh (host %s, %s arquivo(s))\n' "$hago" "$host" "$files" ;;
+    nochange) printf 'telemetria: sem novidade desde o último push há %sh\n' "$hago" ;;
+    skipped)  printf 'telemetria: dentro do intervalo (último push há %sh)\n' "$hago" ;;
+    failed)
+      printf 'telemetria: falhou (%s) — --push tenta de novo\n' "$reason"
+      exit 2 ;;
+    *) printf 'telemetria: configurada, nunca publicou (a próxima sessão publica; --push força)\n' ;;
+  esac
+  return 0
+}
+
+_telemetry_push() { # --push: publica AGORA, ignorando o intervalo (ação explícita do humano)
+  if ! maestro_telemetry_enabled; then
+    printf 'telemetria: nada configurado (maestro telemetry --remote <url>)\n'
+    exit 1
+  fi
+  maestro_telemetry_push --force
+  case "$TEL_STATE" in
+    pushed)   printf 'telemetria: publicada — host %s, %s arquivo(s)\n' "$TEL_HOST" "$TEL_FILES" ;;
+    nochange) printf 'telemetria: sem novidade\n' ;;
+    *)        printf 'telemetria: falhou (%s)\n' "$TEL_REASON"; exit 2 ;;
+  esac
+  return 0
+}
+
+_telemetry_pull() { # --pull: atualiza o clone local ($MAESTRO_HOME/telemetry) — insumo do retro --all
+  if ! maestro_telemetry_enabled; then
+    printf 'telemetria: nada configurado (maestro telemetry --remote <url>)\n'
+    exit 1
+  fi
+  if ! maestro_telemetry_pull; then
+    printf 'telemetria: falhou (%s)\n' "$TEL_REASON"
+    exit 2
+  fi
+  local hd hid label hosts=() hosts_str=""
+  shopt -s nullglob
+  for hd in "$TEL_DIR"/logs/*/; do
+    hid="${hd%/}"; hid="${hid##*/}"
+    label="?"
+    [[ -f "${hd}HOST" ]] && label=$(head -c 200 -- "${hd}HOST" 2>/dev/null | tr -d '\n\r')
+    [[ -n "$label" ]] || label="?"
+    hosts+=("$hid ($label)")
+  done
+  shopt -u nullglob
+  for hd in "${hosts[@]}"; do hosts_str+="${hosts_str:+ · }$hd"; done
+  printf 'telemetria: clone em dia — %s host(s): %s\n' "${#hosts[@]}" "$hosts_str"
+  return 0
+}
+
+_telemetry_set_remote() { # --remote <url>: liga a publicação nesta máquina (opt-in)
+  local url="$1"
+  [[ "$url" =~ ^[A-Za-z0-9@:/._~+-]{1,200}$ ]] || die validation \
+    "URL de telemetria inválida '$url'" \
+    "esperado uma URL de git sem espaço/aspas — maestro telemetry --remote <url>" 1
+  _tel_cli_config_set_remote "$url" || die env "falha ao gravar config.yaml" \
+    "verifique permissões em \$MAESTRO_HOME" 2
+  printf 'config.yaml: telemetry_remote = %s\n' "$url"
+  return 0
+}
+
+_telemetry_off() { # --off: desliga nesta máquina (remove a chave; nada mais muda)
+  _tel_cli_config_remove_remote || die env "falha ao gravar config.yaml" \
+    "verifique permissões em \$MAESTRO_HOME" 2
+  printf 'telemetria: desligada nesta máquina\n'
+  return 0
+}
+
+cmd_telemetry() { # E20/S-2001 — CLI de hooks/lib/telemetry-sync.sh
+  local mode="status" remote_url=""
+  while (( $# )); do
+    case "$1" in
+      --status) mode="status" ;;
+      --push)   mode="push" ;;
+      --pull)   mode="pull" ;;
+      --off)    mode="off" ;;
+      --remote)
+        mode="remote"
+        if (( $# > 1 )); then remote_url="$2"; shift; else remote_url=""; fi ;;
+      *) die validation "flag desconhecida '$1'" \
+           "maestro telemetry [--push|--pull|--status|--remote <url>|--off]" 1 ;;
+    esac
+    shift
+  done
+
+  # shellcheck source=hooks/lib/common.sh
+  source "$REPO_DIR/hooks/lib/common.sh"
+  # shellcheck source=hooks/lib/telemetry-sync.sh
+  source "$REPO_DIR/hooks/lib/telemetry-sync.sh"
+
+  case "$mode" in
+    status) _telemetry_status ;;
+    push)   _telemetry_push ;;
+    pull)   _telemetry_pull ;;
+    remote) _telemetry_set_remote "$remote_url" ;;
+    off)    _telemetry_off ;;
+  esac
+  return 0
+}
