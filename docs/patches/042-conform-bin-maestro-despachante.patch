+# --------------------------------------------------------------- conform (ordem 042)
+#
+# `maestro conform --check`: lacunas para o projeto entrar no metodo e rodar
+# headless (INTENT v6 Prioridades 3/4) - lib/cmd-conform.sh (e os cinco
+# lib/core-conform-*.sh que ele carrega sob demanda). Aqui fica so o
+# carregador, no molde de `_order_json_lib_load`/`_docs_lib_load`, com die env
+# no lugar dos stubs: modulo ausente derruba SO este comando (I-2), nunca o CLI.
+
+_conform_lib_load() { # carrega lib/cmd-conform.sh - uma vez, degradando por comando (I-2)
+  declare -f cmd_conform >/dev/null 2>&1 && return 0
+  if [[ -f "$REPO_DIR/lib/cmd-conform.sh" ]]; then
+    # shellcheck source=lib/cmd-conform.sh
+    source "$REPO_DIR/lib/cmd-conform.sh" && return 0
+  fi
+  die env "lib/cmd-conform.sh nao encontrado em $REPO_DIR" "reinstale o plugin (maestro doctor)" 2
+}
+
