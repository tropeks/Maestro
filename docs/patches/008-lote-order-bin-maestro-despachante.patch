-  # helpers de derivação -----------------------------------------------------
-  # A janela é o CABEÇALHO, não o arquivo: 20 linhas cobrem o carimbo cheio
-  # (id/ts/epoch/head/branch/frozen/budget_*/doc/intent_* /author_session + as
-  # duas linhas do comentário) e param antes do corpo, onde `branch:` escrito à
-  # mão pelo humano não pode virar campo. Era 14 até o E22 acrescentar
-  # intent_version/intent_hash — cabeçalho maior, mesma garantia.
-  _order_field() { awk -F': ' -v k="$2" 'NR>20 { exit } $1 == k { print substr($0, length(k)+3); exit }' "$1" 2>/dev/null; }
-  # issue #13 (ordem 004) — nem todo `.md` em .maestro/orders/ é ordem. Mesmo
-  # carimbo mínimo exigido pelo session-start (hooks/session-start.sh): o
-  # cabeçalho `<!-- maestro-order v1` E um `id:` bem-formado, os dois dentro
-  # da janela de 20 linhas. `--list` usa isto para não listar (nem contar
-  # duplicata de) doc solto — rollback, rascunho, cópia — como se fosse ordem.
-  _order_valid_stamp() { # <arquivo> → rc 0 se carimbo de ordem válido
-    awk -F': ' '
-      NR>20 { exit }
-      $0 ~ /^<!-- maestro-order v1/ { hdr=1 }
-      $1 == "id" && $2 ~ /^[0-9]{1,3}$/ { idok=1 }
-      END { exit !(hdr && idok) }
-    ' "$1" 2>/dev/null
-  }
