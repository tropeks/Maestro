+# ------------------------------------------------------------------ order (E15)
+#
+# `maestro order`: E24 moveu o núcleo (estado derivado, verificação por área,
+# gate de direção) para lib/core-order-state.sh e as ações do CLI para
+# lib/cmd-order.sh (docs/designs/e24-nucleo-e-adaptadores.md). Aqui fica só o
+# carregador, no molde de maestro_verif_load (linha ~2575), com die env no
+# lugar dos stubs: módulo ausente derruba SÓ este comando (I-2), nunca o CLI.
+
+_order_lib_load() { # carrega core-order-state.sh + cmd-order.sh — uma vez, degradando por comando (I-2)
+  declare -f cmd_order >/dev/null 2>&1 && return 0
+  if [[ -f "$REPO_DIR/lib/core-order-state.sh" && -f "$REPO_DIR/lib/cmd-order.sh" ]]; then
+    # shellcheck source=lib/core-order-state.sh
+    source "$REPO_DIR/lib/core-order-state.sh"
+    # shellcheck source=lib/cmd-order.sh
+    source "$REPO_DIR/lib/cmd-order.sh" && return 0
+  fi
+  die env "lib/cmd-order.sh (ou core-order-state.sh) não encontrado em $REPO_DIR" \
+    "reinstale o plugin (maestro doctor)" 2
 }
 
