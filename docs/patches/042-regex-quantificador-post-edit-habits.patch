+    printf 'maestro: post-edit-habits -- file_path do PostToolUse com %d bytes (teto 1024); rejeitado, sensores nao rodam nesta edicao\n' "${#FILE}" >&2
+    FILE=""
+  fi
   [[ "$FILE" == *'\'* ]] && FILE=""   # escape no caminho: só o jq decodifica com segurança
 fi
 
