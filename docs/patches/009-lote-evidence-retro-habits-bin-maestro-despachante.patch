+#
+# `maestro evidence`: E24 (ordem 009) moveu o FORMATO do recibo (escrita e
+# leitura crua) para lib/core-evidence.sh — o dono do formato — e as ações do
+# CLI para lib/cmd-evidence.sh (docs/designs/e24-nucleo-e-adaptadores.md).
+# Aqui fica só o carregador, no molde de maestro_verif_load, com die env no
+# lugar dos stubs: módulo ausente derruba SÓ este comando (I-2), nunca o CLI.
+# cmd_evidence é chamado de fora do dispatch (cmd_verify, cmd_outcome) — cada
+# um desses sítios chama _ev_lib_load antes, mesma técnica de _order_lib_load.
+
+_ev_lib_load() { # carrega core-evidence.sh + cmd-evidence.sh — uma vez, degradando por comando (I-2)
+  declare -f cmd_evidence >/dev/null 2>&1 && return 0
+  if [[ -f "$REPO_DIR/lib/core-evidence.sh" && -f "$REPO_DIR/lib/cmd-evidence.sh" ]]; then
+    # shellcheck source=lib/core-evidence.sh
+    source "$REPO_DIR/lib/core-evidence.sh"
+    # shellcheck source=lib/cmd-evidence.sh
+    source "$REPO_DIR/lib/cmd-evidence.sh" && return 0
+  fi
+  die env "lib/cmd-evidence.sh (ou core-evidence.sh) não encontrado em $REPO_DIR" \
+    "reinstale o plugin (maestro doctor)" 2
 }
 
