+      *) die validation "flag desconhecida '$1'" "maestro order --turno-check [--session s] [--report-file f] | --turno-livre N" 1 ;;
+    esac
+    shift
+  done
+  # shellcheck source=hooks/lib/common.sh
+  source "$REPO_DIR/hooks/lib/common.sh"
