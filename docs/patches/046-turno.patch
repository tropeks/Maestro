+}
+_order_turno_cmd() { # --turno-check [--session s] [--report-file f] | --turno-livre N — ordem 046 (Stop de turno)
+  local act="$1" oid="" sid="" rf="" proj="${CLAUDE_PROJECT_DIR:-$PWD}" of
