{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyWrite": [
        "~/dev/Maestro/hooks",
        "~/dev/Maestro/lib",
        "~/dev/Maestro/bin",
        "~/dev/Maestro/src",
        "~/dev/Maestro/agents",
        "~/dev/Maestro/config/routing-table.yaml",
        "~/dev/Maestro/config/accept-proof.pub",
        "~/dev/Maestro/.claude-plugin",
        "~/.claude/plugins"
      ]
    },
    "network": {
      "allowedDomains": ["github.com", "api.github.com", "*.githubusercontent.com"]
    },
    "excludedCommands": ["ssh *", "ssh:*"]
  },
  "permissions": {
    "deny": [
      "Bash(git push -f*)"
    ],
    "ask": [
      "Edit(//home/rcosta00/.claude/settings*.json)",
      "Edit(.github/workflows/**)",
      "Bash(gh pr merge:*)"
    ]
  }
}
